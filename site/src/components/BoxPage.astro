---
import Base from '../layouts/Base.astro';
import { box,children,compact,exact,basisLabels,sourceFor,href,titles,manifest,type Box } from '../lib/data';
const {id,front=false}=Astro.props as {id:string;front?:boolean};
const node=box(id);
const displayed=node?.collapse_into?box(node.collapse_into)??node:node;
const entries=displayed?children(displayed.id):[];
const positive=entries.filter(n=>n.amount_cents>0&&n.kind!=='rounding');
const negative=entries.filter(n=>n.amount_cents<0&&n.kind!=='rounding');
const rounding=entries.filter(n=>n.kind==='rounding');
const denominator=Math.max(Math.abs(displayed?.amount_cents??0),positive.reduce((sum,n)=>sum+n.amount_cents,0));
const path=displayed?.id.split('.')??[];
const crumbs=path.map((_,i)=>box(path.slice(0,i+1).join('.'))).filter((n):n is Box=>!!n);
const citations=displayed?sourceFor(displayed):[];
---
<Base title={displayed?.name??'Box not found'}><div class="stack hero">{displayed ? <><nav class="breadcrumbs" aria-label="Breadcrumb"><ol>{crumbs.map(n=><li><a href={href(n)}>{n.name}</a></li>)}</ol></nav><header><p class="eyebrow">{titles[displayed.root??id.split('.')[0]]??'Budget box'}</p><h1 tabindex="-1">{displayed.name}</h1><div class="amount">{compact(displayed.amount_cents)}</div><p>Exact amount: <strong>{exact(displayed.amount_cents)}</strong></p><span class="badge" data-basis={displayed.basis}>{basisLabels[displayed.basis??'']??displayed.basis}{displayed.period_label?` (${displayed.period_label})`:''}</span>{displayed.note&&<p>{displayed.note}</p>}{displayed.why&&<p class="callout">{displayed.why}</p>}{displayed.amount_cents<0&&<p>This box takes money away from the box above.</p>}</header>{front&&<div class="callout"><p>The larger a box, the more money it holds. Estimates and leftovers have their own labels. <a href="/glossary">What do the labels mean?</a></p>{manifest.coverage?.[id]&&<p><strong>{Math.round(manifest.coverage[id].strict.lt1m*100)} cents of every dollar</strong> reach a box under $1 million by the box you land on. If each budgeted position counts as its own small box, it is {Math.round(manifest.coverage[id].build.lt1m*100)} cents. <a href="/gaps">See what we could not find</a>.</p>}</div>}{id==='city'&&<p><a href="/city/counted-twice">See money counted twice between City funds</a>. It is not part of the City net total.</p>}{id==='cps'&&<p>CPS fiscal year 2026 runs from July 2025 through June 2026.</p>}{entries.length>0 ? <section id="inside" aria-labelledby="inside-heading"><h2 id="inside-heading">Inside this box</h2>{positive.length>0&&<><ul class="tiles" aria-label="Boxes that add money">{positive.slice(0,20).map(n=><li><a class="tile" href={href(n)} aria-label={`${n.name}, ${compact(n.amount_cents)}, ${basisLabels[n.basis??'']??n.basis}, ${denominator?Math.round(n.amount_cents/denominator*100):0} percent of boxes that add money`}><strong>{n.short_name??n.name}</strong><span>{compact(n.amount_cents)}</span><div class="bar" aria-hidden="true"><span style={`width:${denominator?Math.max(1,n.amount_cents/denominator*100):0}%`}></span></div><span class="badge" data-basis={n.basis}>{basisLabels[n.basis??'']??n.basis}</span></a></li>)}</ul>{positive.length>20&&<p>{positive.length-20} more boxes are listed below.</p>}</>}{negative.length>0&&<section aria-labelledby="negative-heading"><h3 id="negative-heading">Boxes that take money away</h3><ul>{negative.map(n=><li><a href={href(n)}>{n.name}</a>: {exact(n.amount_cents)}</li>)}</ul></section>}<h3>All boxes as a list</h3><div class="table-scroll"><table><caption>Amounts inside {displayed.name}</caption><thead><tr><th scope="col">Box</th><th scope="col">Amount</th><th scope="col">Share</th><th scope="col">How we know</th></tr></thead><tbody>{entries.filter(n=>n.kind!=='rounding').map(n=><tr><th scope="row"><a href={href(n)}>{n.name}</a></th><td class="numeric">{exact(n.amount_cents)}</td><td class="numeric">{denominator?`${Math.round(Math.abs(n.amount_cents)/denominator*100)}%`:'not available'}</td><td>{basisLabels[n.basis??'']??n.basis}</td></tr>)}</tbody></table></div>{rounding.length>0&&<p>Plus rounding: {exact(rounding.reduce((sum,n)=>sum+n.amount_cents,0))}.</p>}</section>:<p>This box has no smaller boxes to open.</p>}{citations.length>0&&<section><h2>Sources</h2><ul>{citations.map(s=><li>{s.url?<a href={s.url} rel="noopener noreferrer">{s.name??s.doc??s.url}</a>:<span>{s.name??s.doc??'Public source'}</span>}</li>)}</ul></section>}{displayed.side?.length>0&&<section><h2>More facts</h2><ul>{displayed.side.map((fact:any)=><li>{fact.label??fact.kind}: {fact.value??(fact.amount_cents!=null?exact(fact.amount_cents):'')} {fact.period&&`(${fact.period})`}</li>)}</ul></section>}{displayed.parent_id&&<p><a href={href(box(displayed.parent_id)??{id:displayed.parent_id,name:'Parent',amount_cents:0})}>↑ Up one level</a></p>}</> : <><h1>Box not found</h1><p>This link may have changed after a data update.</p><a href="/find">Search for the box</a></>}</div></Base>
