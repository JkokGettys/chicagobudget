---
import Base from '../layouts/Base.astro';
import {sourceUrl} from '../lib/sources';
import SideFacts from './SideFacts.astro';
import { box,children,compact,exact,basisLabels,sourceFor,href,titles,manifest,type Box } from '../lib/data';
const {id,front=false}=Astro.props as {id:string;front?:boolean};
const node=box(id);
const displayed=node?.collapse_into?box(node.collapse_into)??node:node;
const entries=displayed?children(displayed.id):[];
const positive=entries.filter(n=>n.amount_cents>0&&n.kind!=='rounding');
const negative=entries.filter(n=>n.amount_cents<0&&n.kind!=='rounding');
const rounding=entries.filter(n=>n.kind==='rounding');
const denominator=Math.max(Math.abs(displayed?.amount_cents??0),positive.reduce((sum,n)=>sum+n.amount_cents,0));
const path=displayed?.id.split('.')??[];
const crumbs=path.map((_,i)=>box(path.slice(0,i+1).join('.'))).filter((n):n is Box=>!!n);
const citations=displayed?sourceFor(displayed):[];
---
<Base title={displayed?.name??'Box not found'}><div class="stack hero box-page">{displayed ? <><nav class="breadcrumbs" aria-label="Breadcrumb"><ol>{crumbs.map(n=><li><a href={href(n)}>{n.name}</a></li>)}</ol></nav><header class="box-hero"><div class="box-hero-main"><p class="eyebrow">{titles[displayed.root??id.split('.')[0]]??'Budget box'}</p><h1 tabindex="-1">{displayed.name}</h1><div class="amount">{compact(displayed.amount_cents)}</div><p>Exact amount: <strong>{exact(displayed.amount_cents)}</strong></p><span class="badge" data-basis={displayed.basis}>{basisLabels[displayed.basis??'']??displayed.basis}{displayed.period_label?` (${displayed.period_label})`:''}</span>{displayed.note&&<p>{displayed.note}</p>}{displayed.why&&<p class="callout">{displayed.why}</p>}{displayed.amount_cents<0&&<p>This box takes money away from the box above.</p>}<p><a class="flow-link" href={`/?box=${encodeURIComponent(displayed.id)}`}>Explore this flow <span aria-hidden="true">↗</span></a></p></div><div class="box-hero-art" aria-hidden="true"><span>ONE BOX</span><span>AT A TIME</span><span>↗</span></div></header>{front&&<div class="callout"><p>The larger a box, the more money it holds. Estimates and leftovers have their own labels. <a href="/glossary">What do the labels mean?</a></p>{manifest.coverage?.[id]&&<p><strong>{Math.round(manifest.coverage[id].strict.lt1m*100)} cents of every dollar</strong> reach a box under $1 million by the box you land on. If each budgeted position counts as its own small box, it is {Math.round(manifest.coverage[id].build.lt1m*100)} cents. <a href="/gaps">See what we could not find</a>.</p>}</div>}{id==='city'&&<p><a href="/city/counted-twice">See money counted twice between City funds</a>. It is not part of the City net total.</p>}{id==='cps'&&<p>CPS fiscal year 2026 runs from July 2025 through June 2026.</p>}{entries.length>0 ? <section class="inside-section" id="inside" aria-labelledby="inside-heading"><div class="inside-intro"><p class="eyebrow">Follow the money</p><h2 id="inside-heading">Inside this box</h2><p>Pick a box to see what is inside it. Larger bars mean larger amounts.</p></div>{negative.length>0&&<p>Boxes that add money total {exact(entries.filter(n=>n.amount_cents>0).reduce((sum,n)=>sum+n.amount_cents,0))}. Boxes that take money away total {exact(entries.filter(n=>n.amount_cents<0).reduce((sum,n)=>sum+n.amount_cents,0))}. Together they make {exact(displayed.amount_cents)}.</p>}{positive.length>0&&<><ul class="tiles" aria-label="Boxes that add money">{positive.slice(0,20).map(n=><li><a class="tile" href={href(n)} aria-label={`${n.name}, ${compact(n.amount_cents)}, ${basisLabels[n.basis??'']??n.basis}, ${denominator?Math.round(n.amount_cents/denominator*100):0} percent of boxes that add money`}><strong>{n.short_name??n.name}</strong><span>{compact(n.amount_cents)}</span><div class="bar" aria-hidden="true"><span style={`width:${denominator?Math.max(1,n.amount_cents/denominator*100):0}%`}></span></div><span class="badge" data-basis={n.basis}>{basisLabels[n.basis??'']??n.basis}</span></a></li>)}</ul>{positive.length>20&&<p>{positive.length-20} more boxes are listed below.</p>}</>}{negative.length>0&&<section aria-labelledby="negative-heading"><h3 id="negative-heading">Boxes that take money away</h3><ul>{negative.map(n=><li><a href={href(n)}>{n.name}</a>: {exact(n.amount_cents)}</li>)}</ul></section>}<h3>All boxes as a list</h3><div class="table-scroll"><table><caption>Amounts inside {displayed.name}</caption><thead><tr><th scope="col">Box</th><th scope="col">Amount</th><th scope="col">Share</th><th scope="col">How we know</th></tr></thead><tbody>{entries.filter(n=>n.kind!=='rounding').map(n=><tr><th scope="row"><a href={href(n)}>{n.name}</a></th><td class="numeric">{exact(n.amount_cents)}</td><td class="numeric">{denominator?`${Math.round(Math.abs(n.amount_cents)/denominator*100)}%`:'not available'}</td><td>{basisLabels[n.basis??'']??n.basis}</td></tr>)}</tbody></table></div>{rounding.length>0&&<p>Plus rounding: {exact(rounding.reduce((sum,n)=>sum+n.amount_cents,0))}.</p>}</section>:<p>This box has no smaller boxes to open.</p>}{citations.length>0&&<section class="sources-section"><h2>Sources</h2><ul>{citations.map(s=><li>{sourceUrl(s)?<a href={sourceUrl(s)} rel="noopener noreferrer">{s.name??s.doc??'View source'}</a>:<span>{s.name??s.doc??'Public source'}</span>}</li>)}</ul></section>}<SideFacts side={displayed.side} sideRef={displayed.side_ref} />{displayed.parent_id&&<p><a href={href(box(displayed.parent_id)??{id:displayed.parent_id,name:'Parent',amount_cents:0})}>↑ Up one level</a></p>}</> : <><h1>Box not found</h1><p>This link may have changed after a data update.</p><a href="/find">Search for the box</a></>}</div></Base>
<style>
.box-page{padding-top:1.3rem}.box-page .breadcrumbs{margin-bottom:0}.box-page .breadcrumbs ol{gap:.4rem .7rem;font-size:.86rem}.box-page .breadcrumbs a{color:var(--muted);text-decoration:none}.box-page .breadcrumbs a:hover{text-decoration:underline}.box-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,.38fr);gap:2rem;background:#142c3a;color:white;border-radius:1.6rem;padding:clamp(1.5rem,4vw,3.5rem);overflow:hidden}.box-hero-main{min-width:0}.box-hero .eyebrow{color:#bce7d7}.box-hero h1{font-size:clamp(2.3rem,5vw,5rem);line-height:1.02;letter-spacing:-.06em;margin:.5rem 0 1.5rem;overflow-wrap:anywhere}.box-hero .amount{font-size:clamp(2rem,4vw,3.5rem);color:#c4f0d8}.box-hero p{max-width:65ch}.box-hero .badge{margin:.2rem 0}.box-hero .callout{color:var(--ink);border-radius:.5rem}.flow-link{display:inline-flex;align-items:center;gap:2rem;min-height:3rem;background:#c4f0d8;color:#142c3a;padding:.6rem 1.1rem;border-radius:100px;font-weight:800;text-decoration:none;transition:transform .18s ease}.flow-link:hover{transform:translateY(-3px)}.box-hero-art{align-self:stretch;min-height:200px;display:flex;flex-direction:column;justify-content:center;align-items:center;background:#c4f0d8;color:#142c3a;border-radius:1.2rem;transform:rotate(5deg);font-size:clamp(1.6rem,3vw,3.2rem);font-weight:900;letter-spacing:-.06em;line-height:1.1}.box-hero-art span:last-child{font-size:3rem;margin-top:1rem}.box-page>.callout{border-radius:0 1rem 1rem 0;background:#e5f4ee;padding:1.4rem 1.7rem}.inside-section{scroll-margin-top:2rem}.inside-intro{margin:3rem 0 1.5rem}.inside-intro h2{font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.05em;margin:.2rem 0}.inside-intro p:last-child{color:var(--muted)}.box-page .tiles{grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr));gap:1rem}.box-page .tile{min-height:12rem;display:flex;flex-direction:column;padding:1.3rem;border:1px solid var(--line);border-radius:1rem;box-shadow:0 3px 14px #112c3010;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}.box-page .tile:hover{transform:translateY(-3px);box-shadow:0 12px 26px #112c3026;border-color:#187e72}.box-page .tile strong{font-size:1.15rem;line-height:1.25;margin-bottom:.6rem;overflow-wrap:anywhere}.box-page .tile>.bar{width:100%;margin-top:auto;background:#dce9e6;height:.55rem}.box-page .tile>.bar span{background:#187e72}.box-page .tile>.badge{align-self:flex-start}.box-page .table-scroll{border:1px solid var(--line);border-radius:1rem}.box-page table{min-width:600px}.box-page table caption{text-align:left;padding:.8rem 1rem;font-weight:700}.box-page th{background:#e5f4ee}.box-page tr:hover td,.box-page tr:hover th{background:#f0f8f5}.sources-section{border-top:1px solid var(--line);padding-top:2rem}.sources-section ul{line-height:1.9}@media(max-width:700px){.box-hero{grid-template-columns:1fr}.box-hero-art{display:none}.box-page .tiles{grid-template-columns:1fr}.box-page .tile{min-height:8rem}}@media(prefers-reduced-motion:reduce){.box-page .tile,.flow-link{transition:none}.box-page .tile:hover,.flow-link:hover{transform:none}}
</style>
