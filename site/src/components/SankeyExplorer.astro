---
// Mounted on the home page. Budget data is loaded in the browser, one branch at a time.
---
<section class="sankey-explorer" data-sankey-explorer aria-labelledby="sankey-title">
  <header class="explorer-intro">
    <div>
      <p class="explorer-kicker">Explore the budgets</p>
      <h2 id="sankey-title">Follow a dollar, one level at a time.</h2>
    </div>
    <p>Choose an independent budget, then open any line to see what is inside it. These budgets may overlap, so they are never added together.</p>
    <p class="explorer-fallback">Or browse the full <a href="/city">City</a>, <a href="/cps">schools</a>, and <a href="/parks">Park District</a> pages.</p>
  </header>
  <p class="explorer-status" data-status role="status" aria-live="polite">Loading budgets…</p>
  <div class="explorer-workspace">
    <section class="explorer-choose" aria-labelledby="explorer-choose-title">
      <h3 id="explorer-choose-title">Choose a budget</h3>
      <p>Three separate starting points</p>
      <div data-roots class="explorer-roots"></div>
    </section>
    <div class="explorer-main" data-main hidden>
      <nav data-crumbs class="explorer-crumbs" aria-label="Budget path"></nav>
      <div data-panel class="explorer-panel"></div>
      <section data-detail class="explorer-detail" aria-label="Selected budget line"></section>
    </div>
  </div>
</section>
<script>
  import {layoutFlow} from '../lib/sankeyLayout';
  import {renderSideFacts} from '../lib/sideFacts';
  import {sourceUrl} from '../lib/sources';

  type Node = {id:string; name:string; short_name?:string|null; amount_cents:number; parent_id?:string|null; root?:string; basis?:string; period?:string|null; period_label?:string|null; note?:string|null; why?:string|null; source?:number|number[]; side?:Record<string,unknown>[]; side_ref?:string|null; is_leaf?:boolean; n_children?:number; kind?:string; collapse_into?:string|null};
  type Chunk = {nodes?:Node[];stubs?:Node[]};
  type Manifest = {chunks:Record<string,string>};
  const roots=['city','cps','parks'];
  const title:Record<string,string>={city:'City of Chicago',cps:'Chicago Public Schools',parks:'Chicago Park District'};
  const basis:Record<string,string>={budget:'In the budget',tied:'Adds up exactly',gov_estimate:'Government estimate',paid_to_date:'Paid so far',proxy:'Our estimate',residual:'Leftover',adjustment:'Adjustment'};
  const periodFor=(node:Node)=>node.period_label??node.period??((node.root??node.id.split('.')[0])==='cps'?'FY2026 · July 2025–June 2026':(node.root??node.id.split('.')[0])==='parks'?'Park District FY2026':'City calendar year 2026');
  const money=(cents:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(cents/100);
  // Negative adjustments retain their sign. A zero parent has no meaningful share.
  const share=(amount:number,parent:number)=>parent===0?null:`${new Intl.NumberFormat('en-US',{style:'percent',minimumFractionDigits:1,maximumFractionDigits:1}).format(amount/Math.abs(parent))} of parent`;
  const amountWithShare=(amount:number,parent:number)=>{const ratio=share(amount,parent);return ratio?`${money(amount)} · ${ratio}`:money(amount)};
  const short=(cents:number)=>{const n=Math.abs(cents)/100;const result=n>=1e9?`$${(n/1e9).toFixed(2)}b`:n>=1e6?`$${(n/1e6).toFixed(1)}m`:money(Math.abs(cents));return cents<0?`−${result}`:result};
  const el=<K extends keyof HTMLElementTagNameMap>(tag:K,text?:string):HTMLElementTagNameMap[K]=>{const item=document.createElement(tag);if(text!==undefined)item.textContent=text;return item};
  const add=(parent:Element,tag:keyof HTMLElementTagNameMap,text:string)=>{const item=el(tag,text);parent.append(item);return item};
  const fetchJson=async<T,>(url:string):Promise<T>=>{const response=await fetch(url);if(!response.ok)throw Error(`Cannot load ${url}`);return response.json() as Promise<T>};
  const host=document.querySelector<HTMLElement>('[data-sankey-explorer]');
  if(host){
    const rootArea=host.querySelector<HTMLElement>('[data-roots]')!;
    const crumbArea=host.querySelector<HTMLElement>('[data-crumbs]')!;
    const main=host.querySelector<HTMLElement>('[data-main]')!;
    const panel=host.querySelector<HTMLElement>('[data-panel]')!;
    const detail=host.querySelector<HTMLElement>('[data-detail]')!;
    const status=host.querySelector<HTMLElement>('[data-status]')!;
    let manifest:Manifest;
    let spine=new Map<string,Node>();
    let current='';
    let renderVersion=0;
    const chunkCache=new Map<string,Promise<Chunk>>();
    const nodeCache=new Map<string,Node>();
    let sourcesPromise:Promise<Record<string,unknown>[]>|undefined;
    const chunkKey=(id:string)=>Object.keys(manifest.chunks).filter(key=>id===key||id.startsWith(`${key}.`)).sort((a,b)=>b.length-a.length)[0];
    const loadChunk=(key:string):Promise<Chunk>=>{
      if(!chunkCache.has(key)){
        const path=manifest.chunks[key];
        if(!/^chunks\/[a-z0-9-]+\.json$/.test(path))throw Error('Invalid data path');
        chunkCache.set(key,fetchJson<Chunk>(`/data/${path}`).then(chunk=>{for(const node of chunk.nodes??[])nodeCache.set(node.id,node);return chunk}).catch(error=>{chunkCache.delete(key);throw error}));
      }
      return chunkCache.get(key)!;
    };
    const getNode=async(id:string):Promise<Node|undefined>=>{
      const key=chunkKey(id);
      if(key)await loadChunk(key);
      return nodeCache.get(id)??spine.get(id);
    };
    const getChildren=async(parent:Node):Promise<Node[]>=>{
      const key=chunkKey(parent.id);
      const chunk=key?await loadChunk(key):{};
      const found=new Map<string,Node>();
      for(const node of [...spine.values(),...(chunk.nodes??[]),...(chunk.stubs??[])]){
        const parentId=node.parent_id??(node.id.includes('.')?node.id.slice(0,node.id.lastIndexOf('.')):null);
        if(parentId===parent.id)found.set(node.id,node);
      }
      return [...found.values()].sort((a,b)=>Math.abs(b.amount_cents)-Math.abs(a.amount_cents));
    };
    const pathTo=async(id:string):Promise<Node[]>=>{
      const path:Node[]=[];const visited=new Set<string>();let next:string|null|undefined=id;
      while(next&&!visited.has(next)&&path.length<24){visited.add(next);const node=await getNode(next);if(!node)break;path.unshift(node);next=node.parent_id??null}
      return roots.includes(path[0]?.id)?path:[];
    };
    const go=(id:string,historyMode:'push'|'replace'|'none'='push')=>{
      if(id===current&&historyMode==='push')return;
      current=id;
      if(historyMode!=='none'){
        const url=new URL(location.href);
        if(id)url.searchParams.set('box',id);else url.searchParams.delete('box');
        window.history[historyMode==='push'?'pushState':'replaceState']({},'',url);
      }
      void render(id);
    };
    const makeButton=(node:Node,klass:string)=>{
      const button=el('button');button.type='button';button.className=klass;
      button.setAttribute('aria-label',`${node.name}, ${money(node.amount_cents)}${node.n_children?', open smaller lines':''}`);
      button.addEventListener('click',()=>go(node.id));return button;
    };
    const rootNodes:Node[]=[];
    const renderRoots=()=>{
      rootArea.replaceChildren();
      for(const node of rootNodes){
        const button=makeButton(node,'root-option');button.dataset.gov=node.id;
        if(current===node.id||current.startsWith(`${node.id}.`))button.setAttribute('aria-current','location');
        const text=el('span');text.className='root-copy';add(text,'strong',title[node.id]??node.name);add(text,'small',periodFor(node));button.append(text);
        add(button,'span',money(node.amount_cents)).className='root-amount';
        rootArea.append(button);
      }
    };
    const renderCrumbs=(path:Node[])=>{
      crumbArea.replaceChildren();
      const back=el('button',path.length>1?'← Back one level':'← All budgets');back.type='button';back.className='crumb-back';back.addEventListener('click',()=>go(path.length>1?path[path.length-2].id:''));crumbArea.append(back);
      const trail=el('ol');trail.className='crumb-trail';
      for(const node of path){const li=el('li');const button=el('button',node.short_name??node.name);button.type='button';if(node.id===current)button.setAttribute('aria-current','page');button.title=node.name;button.addEventListener('click',()=>go(node.id));li.append(button);trail.append(li)}
      crumbArea.append(trail);
    };
    const renderPanel=async(parent:Node):Promise<HTMLElement>=>{
      const entries=await getChildren(parent);
      const area=el('section');area.className='flow-step';area.setAttribute('aria-label',`Inside ${parent.name}`);
      const heading=el('div');heading.className='flow-heading';
      const titleBox=el('div');add(titleBox,'p',entries.length?'Inside this line':'End of this path').className='flow-overline';add(titleBox,'h3',parent.name);heading.append(titleBox);
      add(heading,'strong',money(parent.amount_cents)).className='flow-total';area.append(heading);
      if(!entries.length){add(area,'p','No smaller lines are listed here. Use the path above to explore a different branch.').className='flow-empty';return area}
      const layout=layoutFlow(parent.amount_cents,entries,{width:180,height:280,maxVisualChildren:8,gap:4});
      const body=el('div');body.className='flow-body';
      const chartWrap=el('div');chartWrap.className='flow-visual';
      add(chartWrap,'h4','Proportional flow');
      const chart=el('div');chart.className='flow-chart';chart.style.height=`${layout.height}px`;
      if(layout.rows.length){
        const source=el('div');source.className='flow-source';source.style.height=`${layout.sourceHeight}px`;source.setAttribute('aria-label',`Positive outgoing lines: ${money(layout.positiveTotalCents)}`);source.title=`Positive outgoing lines: ${money(layout.positiveTotalCents)}`;chart.append(source);
        const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('viewBox',`0 0 ${layout.width} ${layout.height}`);svg.setAttribute('preserveAspectRatio','none');svg.classList.add('flow-ribbons');
        for(const row of layout.rows){
          const ribbon=document.createElementNS('http://www.w3.org/2000/svg','path');ribbon.setAttribute('d',row.path);ribbon.setAttribute('class',row.isOverflow?'ribbon overflow':'ribbon');
          const label=row.isOverflow?`${row.children.length} additional lines, ${amountWithShare(row.amount_cents,parent.amount_cents)}. Browse the complete list.`:`${row.children[0].name}, ${amountWithShare(row.amount_cents,parent.amount_cents)}. Open this line.`;
          ribbon.setAttribute('role','button');ribbon.setAttribute('tabindex','0');ribbon.setAttribute('aria-label',label);
          const open=()=>{if(row.isOverflow){search.focus();list.scrollIntoView({block:'nearest'})}else go(row.children[0].id)};
          ribbon.addEventListener('click',open);ribbon.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();open()}});svg.append(ribbon);
          if(row.height>=18){const target=el('button');target.type='button';target.className='flow-target';target.style.top=`${row.y}px`;target.style.height=`${row.height}px`;target.title=label;target.setAttribute('aria-label',label);target.textContent=row.isOverflow?`${row.children.length} more · ${short(row.amount_cents)}`:`${row.children[0].short_name??row.children[0].name} · ${short(row.amount_cents)}`;target.addEventListener('click',open);chart.append(target)}
        }
        chart.append(svg);
      }else add(chart,'p','No positive amounts to draw. See the list for adjustments and zero-dollar lines.').className='flow-no-ribbons';
      chartWrap.append(chart);
      add(chartWrap,'p','Ribbon area shows positive amounts only. Select a ribbon or use the complete list.').className='flow-caption';
      body.append(chartWrap);
      const listSection=el('div');listSection.className='flow-list';
      const listHeading=el('div');listHeading.className='list-heading';add(listHeading,'h4','Smaller lines');add(listHeading,'span',parent.amount_cents===0?'Amount':'Amount · % of parent').className='list-amount-heading';listSection.append(listHeading);
      const search=el('input');search.type='search';search.placeholder='Filter lines by name';search.setAttribute('aria-label',`Filter lines inside ${parent.name}`);listSection.append(search);
      const list=el('ul');list.setAttribute('aria-label',`Lines inside ${parent.name}`);listSection.append(list);
      const drawList=()=>{
        list.replaceChildren();const query=search.value.trim().toLocaleLowerCase();let matches=0;
        for(const node of entries){if(query&&!`${node.name} ${node.short_name??''}`.toLocaleLowerCase().includes(query))continue;matches++;
          const li=el('li');const button=makeButton(node,'flow-list-link');
          const name=el('span');name.className='list-name';add(name,'span',node.name);
          if(node.amount_cents<0)add(name,'small','Adjustment · takes away');else if(node.amount_cents===0)add(name,'small','Zero-dollar line');else if(node.n_children)add(name,'small',`${node.n_children} smaller lines`);
          button.append(name);add(button,'strong',amountWithShare(node.amount_cents,parent.amount_cents));li.append(button);list.append(li);
        }
        if(!matches)add(list,'li','No lines match this filter.').className='list-empty';
      };
      search.addEventListener('input',drawList);drawList();body.append(listSection);area.append(body);
      if(layout.explanation){
        const note=el('p');note.className='flow-explanation';
        if(layout.positiveTotalCents>Math.max(0,parent.amount_cents)){
          const adjustment=money(Math.abs(layout.negativeTotalCents));
          note.textContent=layout.negativeTotalCents&&layout.positiveTotalCents+layout.negativeTotalCents===parent.amount_cents
            ?`${money(layout.positiveTotalCents)} in positive lines minus ${adjustment} in adjustments = ${money(parent.amount_cents)} net. Ribbons show only the positive lines; adjustments are in the list.`
            :`Positive lines total ${money(layout.positiveTotalCents)}, above this line’s ${money(parent.amount_cents)}. ${adjustment} in adjustments is listed separately. These figures do not form a simple sum.`;
        }
        else if(layout.negativeChildren.length)note.textContent=`Adjustments totaling ${money(Math.abs(layout.negativeTotalCents))} take money away. They appear in the list, not as positive ribbons.`;
        else note.textContent=`Listed positive lines total ${money(layout.positiveTotalCents)} of ${money(parent.amount_cents)}. The remainder has no ribbon.`;
        area.append(note);
      }
      if(layout.zeroChildren.length)add(area,'p',`${layout.zeroChildren.length} zero-dollar ${layout.zeroChildren.length===1?'line is':'lines are'} included in the list, with no ribbon.`).className='flow-explanation';
      return area;
    };
    const renderDetail=async(node:Node,version:number,parent?:Node)=>{
      detail.replaceChildren();
      const header=el('div');header.className='detail-heading';const heading=el('div');add(heading,'p',node.is_leaf||node.n_children===0?'Final line':'Selected line').className='detail-overline';add(heading,'h3',node.name);header.append(heading);add(header,'strong',parent?amountWithShare(node.amount_cents,parent.amount_cents):money(node.amount_cents));detail.append(header);
      const meta=el('p');meta.className='detail-meta';meta.textContent=`${title[node.root??node.id.split('.')[0]]??node.root??'Budget'} · ${periodFor(node)} · ${basis[node.basis??'']??node.basis??'Basis not stated'}`;detail.append(meta);
      if(node.amount_cents<0)add(detail,'p','This adjustment takes money away from its parent line.');
      if(node.note)add(detail,'p',node.note);
      if(node.why)add(detail,'p',`Why: ${node.why}`);
      if(node.collapse_into)add(detail,'p','This amount is included in another line; do not add it again.');
      const gov=node.root??node.id.split('.')[0];
      if(roots.includes(gov)){const link=el('a','Open full line page ↗');link.href=node.id===gov?`/${gov}`:`/${gov}/box/${encodeURIComponent(node.id)}`;detail.append(link)}
      if(node.source!==undefined){
        const citations=el('div');citations.className='detail-sources';add(citations,'h4','Sources');const list=el('ul');citations.append(list);detail.append(citations);
        try{
          sourcesPromise??=fetchJson<Record<string,unknown>[]>('/data/sources.json').catch(error=>{sourcesPromise=undefined;throw error});
          const sources=await sourcesPromise;if(version!==renderVersion)return;
          for(const index of (Array.isArray(node.source)?node.source:[node.source])){
            const source=sources[index];if(!source)continue;
            const item=el('li');const url=sourceUrl(source);const label=String(source.name??source.doc??source.dataset??`Source ${index+1}`);
            if(url){const link=el('a',label);link.href=url;link.target='_blank';link.rel='noopener noreferrer';item.append(link)}else item.textContent=label;list.append(item);
          }
        }catch{if(version===renderVersion)add(list,'li','Sources could not be loaded. Open the full line page for citations.')}
      }
      if(node.side_ref||(node.side?.length??0)>0){
        const disclosure=el('details');disclosure.className='detail-side';add(disclosure,'summary','More facts (not included in the budget flow)');const output=el('div');disclosure.append(output);detail.append(disclosure);
        disclosure.addEventListener('toggle',async()=>{
          if(!disclosure.open||disclosure.dataset.loaded==='true')return;
          disclosure.dataset.loaded='true';output.textContent='Loading more facts…';
          try{
            const path=node.side_ref;
            if(path&&!/^side\/[a-z0-9-]+\.json$/.test(path))throw Error('Invalid facts path');
            const facts=path?await fetchJson<Record<string,unknown>[]>(`/data/${path}`):node.side??[];
            if(version===renderVersion)await renderSideFacts(output,facts);
          }catch{output.textContent='Could not load more facts. Close and reopen to retry.';disclosure.dataset.loaded='false'}
        });
      }
    };
    const render=async(id:string)=>{
      const version=++renderVersion;renderRoots();
      if(!id){main.hidden=true;panel.replaceChildren();detail.replaceChildren();status.textContent='Choose one of the three independent budgets to start exploring.';return}
      main.hidden=false;panel.replaceChildren();detail.replaceChildren();status.textContent='Loading budget path…';
      try{
        const path=await pathTo(id);if(version!==renderVersion)return;
        if(!path.length)throw Error('Budget line not found');
        renderCrumbs(path);const selected=path[path.length-1];
        const step=await renderPanel(selected);if(version!==renderVersion)return;panel.replaceChildren(step);
        await renderDetail(selected,version,path[path.length-2]);if(version!==renderVersion)return;
        status.textContent=`Showing ${selected.name}. Select a line to drill down, or go back using the path.`;
      }catch{if(version===renderVersion){main.hidden=true;status.textContent='This line is unavailable. Choose a budget to try again.'}}
    };
    window.addEventListener('popstate',()=>go(new URL(location.href).searchParams.get('box')??'','none'));
    Promise.all([fetchJson<Manifest>('/data/manifest.json'),fetchJson<Node[]>('/data/spine.json')]).then(async([data,spineNodes])=>{
      manifest=data;spine=new Map(spineNodes.map(node=>[node.id,node]));
      for(const id of roots){const node=await getNode(id);if(node)rootNodes.push(node)}
      go(new URL(location.href).searchParams.get('box')??'','none');
    }).catch(()=>{status.textContent='Budget data is unavailable. Please refresh the page to try again.'});
  }
</script>
<style is:global>
  .sankey-explorer{--explorer-paper:var(--paper);--explorer-ink:var(--ink);--explorer-muted:var(--muted);--explorer-line:var(--line);--explorer-accent:var(--accent);--explorer-link:var(--link);color:var(--explorer-ink)}
  .sankey-explorer [hidden]{display:none!important}.explorer-intro{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);align-items:end;gap:.5rem 2rem;border-bottom:1px solid var(--explorer-line);padding-bottom:1rem}.explorer-intro h2{font-size:clamp(1.45rem,2.5vw,2.1rem);line-height:1.16;letter-spacing:-.035em;margin:.2rem 0}.explorer-intro p{line-height:1.5;margin:.25rem 0;color:var(--explorer-muted)}.explorer-intro .explorer-kicker,.flow-overline,.detail-overline{font-size:.69rem;font-weight:750;text-transform:uppercase;letter-spacing:.12em;color:var(--explorer-accent)}.explorer-intro .explorer-fallback{grid-column:1/-1;font-size:.8rem}.sankey-explorer a{color:var(--explorer-link);text-underline-offset:3px}.explorer-status{font-size:.8rem;color:var(--explorer-muted);min-height:1.3em;margin:.8rem 0}
  .explorer-workspace{display:grid;grid-template-columns:minmax(210px,255px) minmax(0,1fr);gap:1.2rem}.explorer-choose{align-self:start}.explorer-choose h3{font-size:.95rem;margin:0}.explorer-choose>p{font-size:.75rem;color:var(--explorer-muted);margin:.25rem 0 .8rem}.explorer-roots{display:grid;gap:.5rem}.root-option{appearance:none;width:100%;display:flex;align-items:center;justify-content:space-between;text-align:left;gap:.5rem;border:1px solid var(--explorer-line);border-radius:.55rem;background:var(--explorer-paper);color:var(--explorer-ink);padding:.8rem;cursor:pointer}.root-option:hover{border-color:var(--explorer-accent);background:color-mix(in srgb,var(--explorer-accent) 4%,var(--explorer-paper))}.root-option[aria-current]{border-color:var(--explorer-accent);box-shadow:inset 3px 0 var(--explorer-accent);background:color-mix(in srgb,var(--explorer-accent) 7%,var(--explorer-paper))}.root-copy{display:grid;gap:.2rem;min-width:0}.root-copy strong{font-size:.83rem;line-height:1.25}.root-copy small{font-size:.66rem;line-height:1.25;color:var(--explorer-muted)}.root-amount{font-size:.9rem;font-weight:750;white-space:nowrap;font-variant-numeric:tabular-nums}
  .explorer-main{min-width:0;border:1px solid var(--explorer-line);border-radius:.7rem;overflow:hidden}.explorer-crumbs{display:flex;align-items:center;gap:.8rem;padding:.65rem .9rem;border-bottom:1px solid var(--explorer-line);min-width:0}.explorer-crumbs button{border:0;background:none;color:var(--explorer-link);font:inherit;cursor:pointer}.crumb-back{white-space:nowrap;font-size:.78rem;font-weight:700;padding:.3rem}.crumb-trail{display:flex;align-items:center;gap:.35rem;list-style:none;margin:0;padding:0;min-width:0;overflow-x:auto;scrollbar-width:thin}.crumb-trail li{display:flex;align-items:center;min-width:0;flex:none}.crumb-trail li+li:before{content:'/';color:var(--explorer-muted);margin-right:.35rem}.crumb-trail button{font-size:.75rem;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:.3rem}.crumb-trail button[aria-current]{color:var(--explorer-ink);font-weight:700}
  .flow-step{padding:1rem}.flow-heading,.detail-heading{display:flex;justify-content:space-between;align-items:baseline;gap:.7rem}.flow-heading h3,.detail-heading h3{font-size:1.12rem;line-height:1.25;margin:.2rem 0 .7rem}.flow-overline,.detail-overline{margin:0}.flow-total,.detail-heading strong{font-size:1.12rem;white-space:nowrap;font-variant-numeric:tabular-nums}.flow-body{display:grid;grid-template-columns:minmax(200px,.8fr) minmax(260px,1.2fr);gap:1rem}.flow-visual h4,.flow-list h4{font-size:.76rem;text-transform:uppercase;letter-spacing:.08em;margin:0 0 .6rem;color:var(--explorer-muted)}.flow-chart{position:relative;width:100%;background:repeating-linear-gradient(to bottom,transparent 0,transparent 55px,var(--explorer-line) 56px);overflow:hidden}.flow-source{position:absolute;left:0;top:0;width:19%;background:var(--explorer-ink);border-radius:3px 0 0 3px}.flow-ribbons{position:absolute;left:19%;top:0;width:35%;height:100%;overflow:visible}.flow-ribbons .ribbon{fill:var(--explorer-accent);opacity:.42;cursor:pointer}.flow-ribbons .ribbon:hover,.flow-ribbons .ribbon:focus{opacity:.78}.flow-ribbons .ribbon.overflow{fill:var(--explorer-muted);opacity:.38}.flow-target{position:absolute;left:54%;right:0;z-index:1;display:block;border:0;border-radius:0 3px 3px 0;box-sizing:border-box;background:var(--explorer-accent);color:var(--accent-ink, var(--explorer-paper));padding:0 .3rem;text-align:left;font-size:.67rem;line-height:1.1;font-weight:700;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;cursor:pointer}.flow-target:hover{filter:brightness(.82)}.flow-no-ribbons{font-size:.82rem;padding:1rem;color:var(--explorer-muted)}.flow-caption{font-size:.69rem;line-height:1.4;color:var(--explorer-muted);margin:.5rem 0 0}
