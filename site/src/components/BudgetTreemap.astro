---
import { children, compact, exact, href, type Box } from '../lib/data';
import { layoutTreemap, type Rectangle } from '../lib/treemapLayout';
const { parent, entries, nested = false } = Astro.props as { parent: Box; entries: Box[]; nested?: boolean };
// Second-level reads are restricted to overview pages, not thousands of deep pages.
const map = layoutTreemap(parent.amount_cents, entries.filter(n => n.kind !== 'rounding'), {
  maxItems: 24, maxDepth: nested ? 1 : 0,
  nested: nested ? (item: Box) => children(item.id).filter(n => n.kind !== 'rounding') : undefined,
});
const overflow = map.rectangles.find(rect => rect.item.id === '__treemap_other__');
const overflowCount = overflow ? entries.filter(n => n.amount_cents > 0 && n.kind !== 'rounding').length - 23 : 0;
const fills = ['#14557f', '#11788b', '#284c78', '#187481', '#376493', '#155f82', '#0d6975', '#315783', '#246e99', '#226773', '#415c8a', '#127b89', '#295a7b', '#176c91'];
const shortNames: Record<string, string> = {
  'Chicago Police Department': 'Police', 'Chicago Fire Department': 'Fire',
  'Chicago Department of Transportation': 'Transportation', 'Chicago Department of Aviation': 'Aviation',
  'Department of Water Management': 'Water Management', 'Department of Streets and Sanitation': 'Streets & Sanitation',
  'Chicago Department of Public Health': 'Public Health', 'Chicago Public Library': 'Public Library',
  'Department of Family and Support Services': 'Family Services',
  'Office of Emergency Management and Communications': 'Emergency Management',
  'Civilian Office of Police Accountability': 'Police Accountability',
  'Office of Public Safety Administration': 'Public Safety Admin',
  'Department of Fleet and Facility Management': 'Fleet & Facilities',
};
function displayName(item: Box): string { return item.short_name ?? shortNames[item.name] ?? item.name; }
function label(rect: Rectangle<Box>) { return rect.item.id === '__treemap_other__' ? `${overflowCount} more boxes` : displayName(rect.item); }
function fullLabel(rect: Rectangle<Box>) { return `${rect.item.id === '__treemap_other__' ? label(rect) : rect.item.name}, ${exact(rect.item.amount_cents)}${rect.item.id === '__treemap_other__' ? ', see the complete list' : ', open this box'}`; }
/** SVG viewBox units. Keep labels deliberately short, never let a clipped word span its neighbor. */
function fit(text: string, width: number, averageGlyph = 8): string {
  const limit = Math.max(0, Math.floor((width - 20) / averageGlyph));
  return text.length <= limit ? text : limit > 3 ? `${text.slice(0, limit - 1).trimEnd()}…` : '';
}
function showName(rect: Rectangle<Box>) { return rect.width >= 90 && rect.height >= 46; }
function showAmount(rect: Rectangle<Box>) { return rect.width >= 125 && rect.height >= 73; }
function header(rect: Rectangle<Box>) { return rect.children.length > 0 && rect.width >= 110 && rect.height >= 65; }
/** Names in the first row sit below the linked category band, without moving any data geometry. */
function childLabelY(child: Rectangle<Box>, group: Rectangle<Box>): number { return Math.max(child.y + 21, header(group) ? group.y + 52 : child.y + 21); }
---
{map.positiveTotalCents > 0 && <figure class="budget-map">
  <figcaption><strong>Where the positive amounts go</strong><span>Each rectangle’s area is proportional to its amount. Select a region to open its box; the list below includes every amount.</span></figcaption>
  {map.positiveTotalCents !== parent.amount_cents && <p class="map-explanation">The rectangles use {exact(map.positiveTotalCents)} in positive amounts as their scale, not the {exact(parent.amount_cents)} net total. {map.negative.length ? `Reductions total ${exact(map.negative.reduce((sum, n) => sum + n.amount_cents, 0))} and appear in the list, not as positive area.` : 'The difference from the parent is not stretched into any rectangle.'}</p>}
  <svg class="treemap" viewBox="0 0 1200 680" role="group" aria-label={`Proportional treemap of positive amounts inside ${parent.name}. The complete accessible list follows.`}>
    <defs>{map.rectangles.map((rect, index) => <><clipPath id={`treemap-label-${index}`}><rect x={rect.x + 4} y={rect.y + 2} width={Math.max(0, rect.width - 8)} height={Math.max(0, rect.height - 4)} /></clipPath>{rect.children.map((sub, subIndex) => <clipPath id={`treemap-label-${index}-${subIndex}`}><rect x={sub.x + 4} y={sub.y + 2} width={Math.max(0, sub.width - 8)} height={Math.max(0, sub.height - 4)} /></clipPath>)}</>)}</defs>
    {map.rectangles.map((rect, index) => <g>
      <a href={header(rect) ? undefined : rect.item.id === '__treemap_other__' ? '#all-boxes' : href(rect.item)} aria-label={header(rect) ? undefined : fullLabel(rect)}>
        <title>{fullLabel(rect)}</title><rect class={Math.min(rect.width, rect.height) < 4 ? 'micro' : ''} x={rect.x} y={rect.y} width={rect.width} height={rect.height} fill={fills[index % fills.length]} />
        {rect.children.length === 0 && showName(rect) && <text clip-path={`url(#treemap-label-${index})`} x={rect.x + 10} y={rect.y + 22} class="name">{fit(label(rect), rect.width)}</text>}
        {rect.children.length === 0 && showAmount(rect) && <text clip-path={`url(#treemap-label-${index})`} x={rect.x + 10} y={rect.y + 41} class="value">{fit(compact(rect.item.amount_cents), rect.width, 7)}</text>}
      </a>
      {rect.children.map((sub, subIndex) => <a href={href(sub.item)} aria-label={`${sub.item.name}, ${exact(sub.item.amount_cents)}, open this box`}>
        <title>{sub.item.name}: {exact(sub.item.amount_cents)}</title><rect class={Math.min(sub.width, sub.height) < 4 ? 'micro' : ''} x={sub.x} y={sub.y} width={sub.width} height={sub.height} fill={fills[(index * 3 + subIndex + 2) % fills.length]} />
        {showName(sub) && childLabelY(sub, rect) + 6 < sub.y + sub.height && <text clip-path={`url(#treemap-label-${index}-${subIndex})`} x={sub.x + 8} y={childLabelY(sub, rect)} class="name sub-name">{fit(displayName(sub.item), sub.width, 7.4)}</text>}
        {showAmount(sub) && childLabelY(sub, rect) + 24 < sub.y + sub.height && <text clip-path={`url(#treemap-label-${index}-${subIndex})`} x={sub.x + 8} y={childLabelY(sub, rect) + 19} class="value">{fit(compact(sub.item.amount_cents), sub.width, 7)}</text>}
      </a>)}
      {rect.children.length > 0 && <rect class="region-outline" x={rect.x} y={rect.y} width={rect.width} height={rect.height} />}
      {header(rect) && <a href={href(rect.item)} aria-label={`Open ${rect.item.name}, ${exact(rect.item.amount_cents)}`} class="parent-link">
        <title>Open {rect.item.name}</title><rect class="parent-band" x={rect.x + 3} y={rect.y + 3} width={rect.width - 6} height="30" />
        <rect class="band-accent" x={rect.x + 3} y={rect.y + 3} width="4" height="30" />
        <text clip-path={`url(#treemap-label-${index})`} x={rect.x + 14} y={rect.y + 24}>{fit(label(rect), rect.width - 40, 8)} ↗</text>
      </a>}
    </g>)}
  </svg>
  <p class="mobile-hint">On small screens, use the complete linked table below to explore each box.</p>
</figure>}
<style>
.budget-map{margin:1.1rem 0 1.5rem}.budget-map figcaption{display:flex;flex-wrap:wrap;gap:.25rem 1rem;align-items:baseline;margin-bottom:.65rem;color:var(--ink)}.budget-map figcaption strong{font-size:1.1rem}.budget-map figcaption span,.map-explanation{color:var(--muted);font-size:.92rem}.map-explanation{margin:.35rem 0 .7rem;max-width:85ch}
.treemap{display:block;width:100%;height:auto;background:#0d2e45;border:3px solid #0d2e45;border-radius:4px}.treemap rect{stroke:#0d2e45;stroke-width:2.5;transition:filter .15s}.treemap rect.micro{stroke:none}.treemap rect.region-outline{fill:none;stroke:#09263b;stroke-width:5;pointer-events:none}.treemap a:hover rect:not(.micro):not(.parent-band):not(.band-accent),.treemap a:focus-visible rect:not(.micro):not(.parent-band):not(.band-accent){filter:brightness(1.3);stroke:#ffd47a;stroke-width:3}.treemap a:focus-visible{outline:none}.treemap text{fill:#fff;font-size:12px;font-weight:720;pointer-events:none;paint-order:stroke;stroke:#113347;stroke-width:1.5;stroke-linejoin:round}.treemap .sub-name{font-size:11.5px}.treemap .value{font-size:10.5px;font-weight:600;fill:#e7f1f4}.treemap .parent-band{fill:#0b2b43;fill-opacity:.93;stroke:none}.treemap .band-accent{fill:#e64b56;stroke:none}.treemap .parent-link text{font-size:12px;font-weight:800;stroke:none}.treemap .parent-link:hover .parent-band,.treemap .parent-link:focus-visible .parent-band{fill:#174f71;fill-opacity:1}.treemap .parent-link:focus-visible .parent-band{stroke:#ffd47a;stroke-width:2}.mobile-hint{display:none}@media(max-width:700px){.treemap{display:none}.mobile-hint{display:block;font-size:.92rem;color:var(--muted)}}
</style>
