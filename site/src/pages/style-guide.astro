---
import Base from '../layouts/Base.astro';
import {basisLabels} from '../lib/data';
---
<Base title="Style guide"><section class="hero"><p class="eyebrow">Design system</p><h1>Style guide</h1><p class="lede">Clear labels, readable numbers, and plain links come first. Color is never the only way to tell two kinds of numbers apart.</p></section><section><h2>Type and spacing</h2><p>System fonts make the page quick to load. Headings lead the eye. Body text stays readable at narrow widths and large zoom.</p><div class="grid"><div class="card"><h3>Color tokens</h3><p>Ink <code>--ink</code>, paper <code>--paper</code>, canvas <code>--canvas</code>, link <code>--link</code>, focus <code>--focus</code>.</p></div><div class="card"><h3>Interaction</h3><p><a href="/city">A plain link to a budget</a></p><label for="example">Search field</label><br/><input id="example" class="search-field" placeholder="A school or a park"/></div></div></section><section class="hero"><h2>Number labels</h2><div class="grid">{Object.entries(basisLabels).map(([key,label])=><div class="card"><span class="badge" data-basis={key}>{label}</span><p>{key==='proxy'?'Our own estimate, marked with a dashed border.':key==='residual'?'A leftover amount, marked with dots.':key==='adjustment'?'A balancing amount, marked with hatching.':'The badge text explains the kind of number.'}</p></div>)}</div></section><section><h2>Box and list views</h2><ul class="tiles"><li><a class="tile" href="/city"><strong>Sample box</strong><span>$1.2 million</span><div class="bar" aria-hidden="true"><span style="width:40%"></span></div><span class="badge" data-basis="budget">In the budget</span></a></li></ul><p>Every linked tile also belongs in a table with full names, exact amounts and column headings.</p></section></Base>
