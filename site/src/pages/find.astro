---
import Base from '../layouts/Base.astro';
---
<Base title="Find"><section class="find-page hero"><h1>Find a box</h1><p class="find-intro">Search public budget boxes by name or place in the budget. <a href="/">Back to the flow ↗</a></p><div class="find-search"><label for="query">Search budget boxes</label><div class="find-input-wrap"><span aria-hidden="true">⌕</span><input id="query" class="search-field" type="search" autocomplete="off" placeholder="Try a school, department or park"/></div><div class="filter-row"><label for="government">Budget</label><select id="government"><option value="">All budgets</option><option value="city">City of Chicago</option><option value="cps">Chicago Public Schools</option><option value="parks">Chicago Park District</option><option value="city-twice">City transfers counted twice</option><option value="vendors">Vendors</option></select></div><p class="find-tip">Search a name or its place in the budget hierarchy.</p></div><p id="status" class="find-status" role="status" aria-live="polite">Type to search.</p><ul class="search-results" id="results"></ul></section><script>
  const input=document.querySelector<HTMLInputElement>('#query')!;
  const status=document.querySelector<HTMLElement>('#status')!;
  const results=document.querySelector<HTMLUListElement>('#results')!;
  const government=document.querySelector<HTMLSelectElement>('#government')!;
  const budgetNames:Record<string,string>={city:'City of Chicago',cps:'Chicago Public Schools',parks:'Chicago Park District','city-twice':'City transfers counted twice',vendors:'Vendors'};
  type Item={id:string;name:string;root?:string;amount_cents?:number;basis?:string;path?:string[]};
  let index:Item[]=[];
  const load=Promise.all(['city','cps','parks','city-twice','vendors'].map(async key=>{try{const response=await fetch(`/data/search/${key}.json`);if(!response.ok)return [];const manifest=await response.json() as {parts:string[]};const parts=await Promise.all(manifest.parts.map(async part=>{const result=await fetch(`/data/search/${part}`);return result.ok?await result.json():[]}));return parts.flat().map((entry:any)=>Array.isArray(entry)?{id:entry[0],name:entry[1],root:'vendors'}:{...entry,root:key}) as Item[]}catch{return []}})).then(parts=>index=parts.flat());
  const safe=(value:string)=>value.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
  let request=0;
  const run=async()=>{const version=++request;const query=input.value.trim().toLocaleLowerCase();const params=new URLSearchParams();if(query)params.set('q',input.value);if(government.value)params.set('budget',government.value);history.replaceState(null,'',params.size?`?${params}`:'/find');if(!query){results.replaceChildren();status.textContent='Type to search.';return}status.textContent='Searching…';await load;if(version!==request)return;const matches=index.filter(n=>(!government.value||n.root===government.value)&&`${n.name} ${n.path?.join(' ')??''}`.toLocaleLowerCase().includes(query)).slice(0,50);results.innerHTML=matches.map(n=>`<li><a href="${n.root==='vendors'?`/vendors/${encodeURIComponent(n.id)}`:n.id==='city-twice'?'/city/counted-twice':n.id===n.root?`/${n.root}`:`/${n.root==='city-twice'?'city':safe(n.root??n.id.split('.')[0])}/box/${encodeURIComponent(n.id)}/`}">${safe(n.name)}</a><br><small>${safe(budgetNames[n.root??'']??n.root??'Budget')}${n.path?.length?' · '+safe(n.path.join(' › ')):''}${n.amount_cents!==undefined?' · '+new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(n.amount_cents/100):''}${n.basis?' · '+safe(n.basis):''}</small></li>`).join('');status.textContent=matches.length?`${matches.length} ${matches.length===1?'result':'results'}${matches.length===50?' shown':''}.`:'No matching boxes. Try another name or department.'};
  const initial=new URLSearchParams(location.search);input.value=initial.get('q')??'';government.value=initial.get('budget')??'';input.addEventListener('input',run);government.addEventListener('change',run);if(input.value)run();
</script><style>
.find-page{max-width:920px;margin:clamp(1rem,3vw,2rem) auto;padding:0 clamp(1rem,3vw,2rem)}.find-page h1{font-size:clamp(2rem,4vw,3.3rem);line-height:1.12;letter-spacing:-.035em;margin:0 0 .5rem;color:var(--ink)}.find-intro{max-width:70ch;color:var(--muted);line-height:1.5;margin:0 0 1rem}.find-intro a{color:var(--link);font-weight:700}.find-search{margin:1rem 0;padding:1rem;border:1px solid var(--line);border-top:3px solid var(--accent);border-radius:var(--radius);background:var(--paper)}.find-search label{display:block;font-weight:700;margin-bottom:.45rem}.find-input-wrap{position:relative}.find-input-wrap span{position:absolute;left:.8rem;top:50%;transform:translateY(-50%);font-size:1.5rem;line-height:1;color:var(--link);pointer-events:none}.find-page .search-field{width:100%;box-sizing:border-box;padding:.75rem .8rem .75rem 2.5rem;border:1px solid var(--line-strong);border-radius:var(--radius-sm);background:var(--paper);color:var(--ink);font:inherit}.find-page .search-field:focus-visible,.find-page select:focus-visible,.find-page .search-results a:focus-visible{outline:3px solid var(--focus);outline-offset:2px}.filter-row{display:flex;align-items:center;gap:.75rem;margin-top:.8rem}.filter-row label{margin:0}.filter-row select{max-width:100%;padding:.45rem .6rem;border:1px solid var(--line-strong);border-radius:var(--radius-sm);background:var(--paper);color:var(--ink);font:inherit}.find-tip{margin:.6rem 0 0;font-size:.85rem;color:var(--muted)}.find-status{min-height:1.5rem;color:var(--muted);font-weight:600}.find-page .search-results{list-style:none;padding:0;margin:.5rem 0;display:grid;gap:.4rem}.find-page .search-results li{padding:.7rem 1rem;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--paper)}.find-page .search-results li:hover,.find-page .search-results li:focus-within{border-color:var(--accent);background:var(--surface-subtle)}.find-page .search-results a{font-weight:700;color:var(--link);text-decoration:none}.find-page .search-results a:hover{text-decoration:underline}.find-page .search-results small{display:inline-block;margin-top:.2rem;color:var(--muted);line-height:1.4;overflow-wrap:anywhere}
</style></Base>
