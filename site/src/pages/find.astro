---
import Base from '../layouts/Base.astro';
---
<Base title="Find"><section class="find-page hero"><p class="find-kicker">Explore the details</p><h1>Find a box</h1><p class="find-intro">Search budget boxes by name. Results open in their budget.</p><div class="find-search"><label for="query">Search public budget boxes</label><div class="find-input-wrap"><span aria-hidden="true">⌕</span><input id="query" class="search-field" type="search" autocomplete="off" placeholder="Try a school, department or park"/></div><p class="find-tip">Search a name or its place in the budget hierarchy.</p></div><p id="status" class="find-status" role="status" aria-live="polite">Type to search.</p><ul class="search-results" id="results"></ul></section><script>
  const input=document.querySelector<HTMLInputElement>('#query')!;
  const status=document.querySelector<HTMLElement>('#status')!;
  const results=document.querySelector<HTMLUListElement>('#results')!;
  type Item={id:string;name:string;root?:string;amount_cents?:number;basis?:string;path?:string[]};
  let index:Item[]=[];
  const load=Promise.all(['city','cps','parks','city-twice','vendors'].map(async key=>{try{const response=await fetch(`/data/search/${key}.json`);if(!response.ok)return [];const manifest=await response.json() as {parts:string[]};const parts=await Promise.all(manifest.parts.map(async part=>{const result=await fetch(`/data/search/${part}`);return result.ok?await result.json():[]}));return parts.flat().map((entry:any)=>Array.isArray(entry)?{id:entry[0],name:entry[1],root:'vendors'}:{...entry,root:key}) as Item[]}catch{return []}})).then(parts=>index=parts.flat());
  const safe=(value:string)=>value.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
  let request=0;
  const run=async()=>{const version=++request;const query=input.value.trim().toLocaleLowerCase();history.replaceState(null,'',query?`?q=${encodeURIComponent(input.value)}`:'/find');if(!query){results.replaceChildren();status.textContent='Type to search.';return}status.textContent='Searching…';await load;if(version!==request)return;const matches=index.filter(n=>`${n.name} ${n.path?.join(' ')??''}`.toLocaleLowerCase().includes(query)).slice(0,50);results.innerHTML=matches.map(n=>`<li><a href="${n.root==='vendors'?`/vendors/${encodeURIComponent(n.id)}`:n.id==='city-twice'?'/city/counted-twice':n.id===n.root?`/${n.root}`:`/${n.root==='city-twice'?'city':safe(n.root??n.id.split('.')[0])}/box/${encodeURIComponent(n.id)}`}">${safe(n.name)}</a><br><small>${safe(n.path?.join(' › ')??'')} ${n.amount_cents!==undefined?' · '+new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(n.amount_cents/100):''}</small></li>`).join('');status.textContent=matches.length?`${matches.length} ${matches.length===1?'result':'results'}${matches.length===50?' shown':''}.`:'No matching boxes. Try another name or department.'};
  input.value=new URLSearchParams(location.search).get('q')??'';input.addEventListener('input',run);if(input.value)run();
</script><style>
  .find-page{max-width:920px;margin:clamp(2rem,6vw,5rem) auto;padding:0 clamp(1rem,3vw,2rem)}
  .find-kicker{text-transform:uppercase;letter-spacing:.17em;font-size:.75rem;font-weight:800;color:#287b75;margin:0 0 .5rem}
  .find-page h1{font-size:clamp(2.7rem,7vw,5rem);line-height:1.05;letter-spacing:-.045em;margin:.2rem 0 1rem}
  .find-intro{font-size:clamp(1rem,2vw,1.2rem);max-width:55ch;color:#48616a;line-height:1.6}
  .find-search{margin:2rem 0 1rem;padding:clamp(1rem,3vw,2rem);border:1px solid #d4e3df;border-radius:1.2rem;background:#f4faf8;box-shadow:0 16px 48px #17303612}
  .find-search label{display:block;font-weight:750;margin-bottom:.7rem}.find-input-wrap{position:relative}.find-input-wrap span{position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:1.9rem;line-height:1;color:#377c78;pointer-events:none}
  .find-page .search-field{width:100%;box-sizing:border-box;padding:1rem 1rem 1rem 3rem;border:1.5px solid #8aaca6;border-radius:.75rem;background:white;color:#173036;font:inherit;font-size:1.05rem;transition:border-color .2s,box-shadow .2s}
  .find-page .search-field:focus-visible{outline:3px solid #d6874b;outline-offset:2px;border-color:#206e70}.find-tip{margin:.65rem 0 0;font-size:.85rem;color:#567078}.find-status{min-height:1.5rem;color:#46636a;font-weight:600}
  .find-page .search-results{list-style:none;padding:0;margin:1rem 0;display:grid;gap:.65rem}.find-page .search-results li{padding:1rem 1.2rem;border:1px solid #dce8e5;border-radius:.8rem;background:#fff;transition:transform .2s,box-shadow .2s,border-color .2s}.find-page .search-results li:hover,.find-page .search-results li:focus-within{transform:translateY(-2px);border-color:#74aaa1;box-shadow:0 8px 24px #17303618}
  .find-page .search-results a{font-weight:750;color:#165d68;text-decoration:none}.find-page .search-results a:hover{text-decoration:underline}.find-page .search-results a:focus-visible{outline:3px solid #d6874b;outline-offset:3px}.find-page .search-results small{display:inline-block;margin-top:.4rem;color:#516b70;line-height:1.5;overflow-wrap:anywhere}
  @media(max-width:600px){.find-page{margin:2rem auto}.find-search{margin-top:1.5rem}.find-page .search-results li{padding:.85rem}}
  @media(prefers-reduced-motion:reduce){.find-page .search-field,.find-page .search-results li{transition:none}.find-page .search-results li:hover,.find-page .search-results li:focus-within{transform:none}}
</style></Base>
