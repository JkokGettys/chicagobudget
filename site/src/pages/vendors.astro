---
import Base from '../layouts/Base.astro';
import {exact} from '../lib/data';
import {readFileSync,existsSync} from 'node:fs';
import {join} from 'node:path';
type Vendor={slug:string;payee_display:string;totals:Record<string,number>;is_individual?:number};
const vendors:Vendor[]=JSON.parse(readFileSync(join(process.cwd(),'public/data/vendors.json'),'utf8'));
const individualPath=join(process.cwd(),'public/data/vendors_individuals.json');
const pooled:{period:string;amount_cents:number;n_payments:number}[]=existsSync(individualPath)?JSON.parse(readFileSync(individualPath,'utf8')):[];
const businesses=vendors.filter(v=>!v.is_individual).sort((a,b)=>(b.totals.city_2026_payments??0)-(a.totals.city_2026_payments??0));
---
<Base title="City vendors"><div class="stack hero"><p class="eyebrow">City payments</p><h1>Companies paid by the City</h1><p class="lede">Explore payments to businesses. The 2026 numbers cover January 1 through September 28, 2026 only. This is a partial year, not a forecast for the full year. The 2025 numbers cover the full year.</p><p class="callout">Payments are grouped by payee and contract to avoid counting a payment twice. Payments do not equal a budget, and a 2026 partial year cannot be compared as if it were a full year. Individual names are hidden and are never searchable.</p>{pooled.length>0&&<section class="card"><h2>Individuals (names hidden)</h2><p>These payments are pooled by year. No individual payment or name is shown.</p><ul>{pooled.map(r=><li>{r.period==='city_2026_payments'?'2026 through September 28 (partial year)':'2025 (full year)'}: {exact(r.amount_cents)} across {r.n_payments.toLocaleString('en-US')} payments</li>)}</ul></section>}<p><a href="/sources">Check the public payment sources</a> · <a href="/about">How payments are counted</a></p>{businesses.length ? <><label for="vendor-filter">Find a business</label><input id="vendor-filter" type="search" class="search-field" placeholder="Search business names"/><p id="vendor-count" aria-live="polite">{businesses.length.toLocaleString('en-US')} businesses</p><div class="table-scroll"><table id="vendor-table"><caption>City business payments in 2026 so far and in full-year 2025</caption><thead><tr><th scope="col">Business</th><th scope="col">2026 paid so far, through Sep 28</th><th scope="col">2025 paid, full year</th></tr></thead><tbody>{businesses.map(v=><tr data-name={v.payee_display.toLocaleLowerCase('en-US')}><th scope="row"><a href={`/vendors/${v.slug}`}>{v.payee_display}</a></th><td class="numeric">{exact(v.totals.city_2026_payments??0)}</td><td class="numeric">{exact(v.totals.city_2025??0)}</td></tr>)}</tbody></table></div><script>const input=document.querySelector<HTMLInputElement>('#vendor-filter');const table=document.querySelector<HTMLTableElement>('#vendor-table');const count=document.querySelector<HTMLElement>('#vendor-count');input?.addEventListener('input',()=>{let shown=0;table?.querySelectorAll<HTMLTableRowElement>('tbody tr').forEach(row=>{row.hidden=!(row.dataset.name??'').includes(input.value.trim().toLocaleLowerCase('en-US'));if(!row.hidden)shown++});if(count)count.textContent=`${shown.toLocaleString('en-US')} businesses shown`});</script></>:<p>Business payment records are not available in this build yet. <a href="/city">Explore City budget boxes</a> instead.</p>}</div></Base>
