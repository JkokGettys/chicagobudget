---
import Base from '../../layouts/Base.astro';
import {box,exact,href,sourceFor} from '../../lib/data';
import {readFileSync} from 'node:fs';
import {join} from 'node:path';
type Row={period:string;amount_cents:number;n_payments?:number;contract_number?:string;department?:string;linked_node_ids?:string[]};
type Vendor={slug:string;payee_display:string;totals:Record<string,number>;rows:Row[];is_individual?:number};
const all:Vendor[]=JSON.parse(readFileSync(join(process.cwd(),'public/data/vendors.json'),'utf8'));
export function getStaticPaths(){const data:Vendor[]=JSON.parse(readFileSync(join(process.cwd(),'public/data/vendors.json'),'utf8'));return data.filter(v=>!v.is_individual).map(v=>({params:{slug:v.slug}}))}
const vendor=all.find(v=>v.slug===Astro.params.slug && !v.is_individual);
const name=vendor?.payee_display??'Business';
const rows=vendor?.rows??[];
const ids=[...new Set(rows.flatMap(r=>Array.isArray(r.linked_node_ids)?r.linked_node_ids:[]))];
const linked=ids.map(id=>box(id)).filter(n=>n!==undefined);
const citations=[...new Map(linked.flatMap(n=>sourceFor(n)).map(s=>[s.url??s.doc??s.name,s])).values()];
---
<Base title={name}><div class="stack hero"><p><a href="/vendors">← All vendors</a></p><h1>{name}</h1><p class="callout">The 2026 figure covers payments from January 1 through September 28, 2026, a partial year. Do not treat it as a full-year amount when comparing it with 2025.</p><div class="grid"><div class="card"><h2>2026 paid so far</h2><p class="amount">{exact(vendor?.totals.city_2026_payments??0)}</p><p>Through September 28, 2026</p></div><div class="card"><h2>2025 paid</h2><p class="amount">{exact(vendor?.totals.city_2025??0)}</p><p>Full year, for context</p></div></div><section><h2>Payment records</h2><div class="table-scroll"><table><caption>City payment records for {name}</caption><thead><tr><th scope="col">Period</th><th scope="col">City department</th><th scope="col">Contract</th><th scope="col">Payments</th><th scope="col">Paid</th></tr></thead><tbody>{rows.map(r=><tr><td>{r.period==='city_2026_payments'?'2026 through Sep 28 (partial)':r.period==='city_2025'?'2025 (full year)':r.period}</td><td>{r.department||'Not listed'}</td><td>{r.contract_number||'Not listed'}</td><td class="numeric">{r.n_payments??'Not listed'}</td><td class="numeric">{exact(r.amount_cents)}</td></tr>)}</tbody></table></div></section>{linked.length>0&&<section><h2>Related budget boxes</h2><p>These links show where payment records connect to the budget. A payment is not the same thing as a budgeted amount. Some 2025 payments may have been coded to a different budget line.</p><ul>{linked.map(n=><li><a href={href(n)}>{n.name}</a> ({exact(n.amount_cents)})</li>)}</ul></section>}<section><h2>Sources</h2><p><a href="/sources">City payment data and budget sources</a></p>{citations.length>0&&<ul>{citations.map(s=><li>{s.url?<a href={s.url}>{s.name??s.doc??'Source document'}</a>:s.name??s.doc??'Source document'}</li>)}</ul>}</section></div></Base>
