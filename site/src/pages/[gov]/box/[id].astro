---
import BoxPage from '../../../components/BoxPage.astro';
import {manifest} from '../../../lib/data';
import {readFileSync} from 'node:fs';
import {join} from 'node:path';
export function getStaticPaths(){
  const seen=new Set<string>();
  const paths:{params:{gov:string;id:string}}[]=[];
  for(const file of Object.values(manifest.chunks??{}) as string[]){
    const data=JSON.parse(readFileSync(join(process.cwd(),'public/data',file),'utf8'));
    for(const n of data.nodes){
      const gov=n.root==='city-twice'?'city':n.root;
      if(!['city','cps','parks'].includes(gov)||n.id===gov||n.id==='city-twice'||seen.has(n.id))continue;
      if((n.depth<=4||Math.abs(n.amount_cents)>=100_000_000)&&n.id.length<245){seen.add(n.id);paths.push({params:{gov,id:n.id}})}
    }
  }
  return paths;
}
const {id}=Astro.params;
---
<BoxPage id={id!}/>
