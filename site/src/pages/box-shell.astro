---
import Base from '../layouts/Base.astro';
---
<Base title="Budget box"><div class="hero stack"><nav class="breadcrumbs" aria-label="Breadcrumb"><ol id="trail"><li><a href="/">Home</a></li></ol></nav><article id="box"><h1 tabindex="-1">Opening this box…</h1><p role="status">Loading public budget data.</p></article></div><script>
  import {displayName} from '../lib/displayName';
  import {sourceUrl} from '../lib/sources';
  import {budgetShare} from '../lib/budgetShare';
  import {initSideFacts} from '../lib/sideFacts';
  import {renderStaffingCount, isPersonnelNode} from '../lib/headcount';
  type RecordBox={id:string;name:string;short_name?:string|null;parent_id?:string;amount_cents:number;basis?:string;period_label?:string;note?:string;why?:string;root?:string;source?:number;side?:Record<string,any>[];side_ref?:string;collapse_into?:string};
  const boxElement=document.querySelector<HTMLElement>('#box')!;
  const trail=document.querySelector<HTMLOListElement>('#trail')!;
  const escape=(s:unknown)=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
  const amount=(c:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(c/100);
  const labels:Record<string,string>={budget:'In the budget',tied:'Adds up exactly',gov_estimate:'Government estimate',paid_to_date:'Paid so far',proxy:'Our estimate',residual:'Leftover',adjustment:'Adjustment'};
  const gov=location.pathname.split('/')[1];
  const id=decodeURIComponent(location.pathname.split('/box/')[1]??'').replace(/\/$/,'');
  const href=(id:string)=>id===gov?`/${gov}`:id==='city-twice'?'/city/counted-twice':`/${gov}/box/${encodeURIComponent(id)}/`;
  const get=async(path:string)=>{const response=await fetch(`/data/${path}`);if(!response.ok)throw Error('Data not available');return response.json()};
  async function render(){
    try{
      const [manifest,sources]=await Promise.all([get('manifest.json'),get('sources.json')]);
      const keys=Object.keys(manifest.chunks).filter(k=>id===k||id.startsWith(k+'.')).sort((a,b)=>b.length-a.length);
      const chunk=keys[0]&&await get(manifest.chunks[keys[0]]);
      const record:RecordBox|undefined=chunk?.nodes.find((n:RecordBox)=>n.id===id);
      if(!record){boxElement.innerHTML='<h1>Box not found</h1><p>This box may have moved after a data update.</p><p><a href="/find">Search for it</a></p>';return}
      document.title=`${record.name} | Chicago budget explorer`;
      const ids=id.split('.').map((_,i)=>id.split('.').slice(0,i+1).join('.'));
      const byId=new Map<string,RecordBox>([...(chunk.ancestors??[]),...chunk.nodes].map((n:RecordBox)=>[n.id,n]));
      trail.innerHTML=ids.map((part:string)=>{const node=byId.get(part);return `<li><a href="${href(part)}" title="${escape(node?.name??part)}">${escape(node?displayName(node):part)}</a></li>`}).join('');
      const children:RecordBox[]=[...chunk.nodes,...(chunk.stubs??[]).map((n:RecordBox)=>({...n,parent_id:n.id.slice(0,n.id.lastIndexOf('.'))}))].filter((n:RecordBox)=>n.parent_id===id).sort((a:RecordBox,b:RecordBox)=>Math.abs(b.amount_cents)-Math.abs(a.amount_cents));
      const source=typeof record.source==='number'?sources[record.source]:undefined;
      const period=record.period_label??(record.basis==='paid_to_date'?undefined:({city:'Calendar year 2026',cps:'FY2026 (July 2025–June 2026)',parks:'FY2026'} as Record<string,string>)[record.root??gov]);
      const positive=children.filter(n=>n.amount_cents>0&&n.name!=='Rounding');
      const negative=children.filter(n=>n.amount_cents<0);
      const share=(n:RecordBox)=>budgetShare(n.amount_cents,record.amount_cents);
      const sideHtml=(record.side_ref||record.side?.length)?'<section id="side-facts"><h2>More facts</h2><details data-side-toggle><summary>Explore additional facts</summary><div data-side-output><p>Open to load facts.</p></div></details></section>':'';
      boxElement.innerHTML=`<header><p class="eyebrow">${escape(gov)} budget box</p><h1 tabindex="-1" title="${escape(record.name)}">${escape(displayName(record))}</h1>${displayName(record)!==record.name?`<details><summary>Official budget title</summary><p>${escape(record.name)}</p></details>`:''}<p class="amount">${amount(record.amount_cents)}</p>${isPersonnelNode(record)?'<aside class="staffing-count" aria-label="Budgeted staffing"></aside>':''}${period?`<p class="budget-period">${escape(period)}</p>`:''}${record.basis&&!['budget','tied'].includes(record.basis)?`<span class="badge" data-basis="${escape(record.basis)}">${escape(labels[record.basis]??record.basis)}</span>`:''}${record.note?`<p>${escape(record.note)}</p>`:''}${record.why?`<p class="callout">${escape(record.why)}</p>`:''}<p><a href="/?box=${encodeURIComponent(record.id)}">Explore this flow →</a></p></header>${children.length?`<section id="inside"><h2>Inside this budget</h2><p class="share-context" title="${escape(record.name)}">Percentages of ${escape(displayName(record))}.</p>${negative.length?`<p>Boxes that add money total ${amount(positive.reduce((s,n)=>s+n.amount_cents,0))}. Boxes that take money away total ${amount(negative.reduce((s,n)=>s+n.amount_cents,0))}. Together they make ${amount(record.amount_cents)}.</p>`:''}<ul class="tiles">${positive.slice(0,20).map(n=>`<li><a class="tile" href="${href(n.id)}" title="${escape(n.name)}"><strong>${escape(displayName(n))}</strong><span class="tile-amount">${amount(n.amount_cents)}</span>${share(n)!==null?`<span class="budget-share" title="${escape(share(n))} of ${escape(record.name)}">${escape(share(n))}</span>`:''}${n.basis&&!['budget','tied'].includes(n.basis)?`<small class="basis-note">${escape(labels[n.basis]??n.basis)}</small>`:''}</a></li>`).join('')}</ul>${negative.length?`<h3>Boxes that take money away</h3><ul>${negative.map(n=>`<li><a href="${href(n.id)}" title="${escape(n.name)}">${escape(displayName(n))}</a>: ${amount(n.amount_cents)}</li>`).join('')}</ul>`:''}<h3>All items</h3><div class="table-scroll"><table><caption title="${escape(record.name)}">Amounts inside ${escape(displayName(record))}</caption><thead><tr><th scope="col">Box</th><th scope="col">Amount</th><th scope="col">% of this budget</th></tr></thead><tbody>${children.map(n=>`<tr><th scope="row"><a href="${href(n.id)}" title="${escape(n.name)}">${escape(displayName(n))}</a></th><td class="numeric">${amount(n.amount_cents)}</td><td class="numeric">${escape(share(n)??'N/A')}</td></tr>`).join('')}</tbody></table></div></section>`:'<p>This box has no smaller boxes to open.</p>'}${sideHtml}${source?`<section><h2>Source</h2><p>${sourceUrl(source)?`<a href="${escape(sourceUrl(source))}" rel="noopener noreferrer">${escape(source.name??source.doc??'View source')}</a>`:escape(source.name??source.doc??'Public source')}</p></section>`:''}${record.parent_id?`<p><a href="${href(record.parent_id)}">↑ Up one level</a></p>`:''}`;
      const staffingElement=boxElement.querySelector<HTMLElement>('.staffing-count');
      if(staffingElement) void renderStaffingCount(staffingElement,record.id,sources,sourceUrl);
      const factsElement=boxElement.querySelector<HTMLElement>('#side-facts');
      if(factsElement){if(record.side_ref)factsElement.dataset.sideRef=`/data/${record.side_ref}`;else factsElement.dataset.side=JSON.stringify(record.side??[]);initSideFacts(factsElement)}
      boxElement.querySelector('h1')?.focus();
    }catch{boxElement.innerHTML='<h1>Could not open this box</h1><p>The data could not be loaded. Please try again later.</p><a href="/find">Find another box</a>'}
  }
  render();
</script></Base>
<style>
  :global(.staffing-count:not(:empty)){border-left:3px solid var(--accent);padding:.2rem 0 .2rem .8rem;margin:.8rem 0;max-width:75ch}
  :global(.staffing-count p){margin:.2rem 0;font-size:.95rem}
  :global(.staffing-count .staffing-note),:global(.staffing-count details){font-size:.85rem;color:var(--muted);line-height:1.45}
  :global(#box .tiles .tile){display:flex;flex-direction:column;align-items:flex-start;gap:.65rem;height:100%;min-width:0}
  :global(#box .tiles .tile strong){font-size:1.05rem;line-height:1.35;overflow-wrap:anywhere}
  :global(#box .tile-amount){font-size:clamp(1rem,1.5vw,1.35rem);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
  :global(#box .budget-share){display:inline-block;margin-top:auto;padding:.25rem .65rem;background:var(--surface-subtle);color:var(--link);border-radius:var(--radius-sm);font-weight:750;font-size:1rem;font-variant-numeric:tabular-nums}
  :global(#box .share-context),:global(#box .budget-period),:global(#box .basis-note){color:var(--muted);font-size:.85rem}
  :global(#box .share-context){margin-top:-.5rem;margin-bottom:1.2rem}
  :global(#box .table-scroll){overflow-x:auto}
</style>
