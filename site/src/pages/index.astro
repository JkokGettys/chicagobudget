---
import Base from '../layouts/Base.astro';
import SankeyExplorer from '../components/SankeyExplorer.astro';
import { roots, titles, box, compact } from '../lib/data';

const periods: Record<string, string> = {
  city: 'Calendar year 2026',
  cps: 'FY2026 · July 2025–June 2026',
  parks: 'Park District FY2026',
};
const budgets = roots.map(root => ({ root, title: titles[root], node: box(root), period: periods[root] }));
---
<Base title="Home" description="Explore Chicago's City, public schools, and Park District budgets. Search public budget lines or follow the flow of each independent budget.">
  <div class="landing">
    <section class="start" aria-labelledby="home-title">
      <div class="start-heading">
        <div>
          <p class="kicker">Chicago budget explorer</p>
          <h1 id="home-title">Find where the money goes.</h1>
          <p class="start-note">Search a service, or open one of three separate 2026 budgets.</p>
        </div>
        <form class="home-search" action="/find" role="search">
          <label for="home-search">Search the budgets</label>
          <div class="search-row">
            <input id="home-search" name="q" type="search" placeholder="School, park, department, or service" autocomplete="off" />
            <button type="submit">Search <span aria-hidden="true">↗</span></button>
          </div>
        </form>
      </div>
      <h2 class="budget-heading" id="budgets-title">Choose a budget</h2>
      <ul class="budget-grid" aria-labelledby="budgets-title">
        {budgets.map(({ root, title, node, period }) =>
          <li>
            <a class="budget-card" href={`/?box=${root}#explore`}>
              <span class="card-label">{title} <span class="card-arrow" aria-hidden="true">↗</span></span>
              <strong class="card-amount">{node ? compact(node.amount_cents) : 'Explore budget'}</strong>
              <span class="card-caption">{period} · Explore the flow</span>
            </a>
            <a class="page-link" href={`/${root}`}>Browse budget page <span aria-hidden="true">↗</span></a>
          </li>
        )}
      </ul>
      <p class="separate-note"><a href="/disclosures">How to compare these budgets ↗</a></p>
    </section>

    <div class="explorer-frame" id="explore">
      <SankeyExplorer />
    </div>

    <aside class="more-links" aria-label="About this data">
      <nav aria-label="Learn more"><a href="/disclosures">Disclosures ↗</a><a href="/sources">Sources ↗</a><a href="/glossary">Budget terms ↗</a><a href="/about">How this works ↗</a><a href="/gaps">Data gaps ↗</a></nav>
    </aside>
  </div>
</Base>
<style>
  .landing { padding-top: clamp(1.25rem, 3vw, 2.5rem); }
  .start { padding-bottom: 1.1rem; }
  .start-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(19rem, 25rem); align-items: end; gap: 1.5rem 3rem; }
  .kicker { margin: 0 0 .5rem; color: var(--link); font-size: .76rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: none; margin: 0; font-family: var(--font-display, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif); font-size: clamp(2rem, 3.7vw, 3.65rem); font-weight: 760; letter-spacing: -.055em; line-height: 1.06; }
  .start-note { margin: .7rem 0 0; color: var(--muted); line-height: 1.5; }
  .home-search label { display: block; margin-bottom: .45rem; font-size: .83rem; font-weight: 700; }
  .search-row { display: flex; min-height: 3.15rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--paper); overflow: hidden; transition: border-color .15s, box-shadow .15s; }
  .search-row:focus-within { border-color: var(--focus); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 16%, transparent); }
  .search-row input { flex: 1; min-width: 0; padding: .75rem .9rem; border: 0; background: transparent; color: var(--ink); outline: 0; font-size: .9rem; }
  .search-row input::placeholder { color: var(--muted); opacity: 1; }
  .search-row button { min-height: auto; margin: .25rem; padding: .5rem .85rem; border-radius: calc(var(--radius-sm) - .15rem); white-space: nowrap; font-size: .85rem; }
  .budget-heading { margin: clamp(1.55rem, 3vw, 2.3rem) 0 .85rem; font-family: var(--font-display, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif); font-size: .98rem; font-weight: 750; letter-spacing: -.02em; }
  .budget-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; list-style: none; padding: 0; margin: 0; }
  .budget-grid li { display: flex; flex-direction: column; min-width: 0; }
  .page-link { display: inline-block; margin: .45rem 0 .1rem .2rem; color: var(--link); font-size: .76rem; font-weight: 650; }
  .budget-card { display: flex; flex-direction: column; flex: 1; min-height: 9rem; padding: 1.05rem 1.2rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--paper); color: var(--ink); text-decoration: none; box-shadow: var(--shadow); transition: border-color .15s, box-shadow .15s, transform .15s; }
  .budget-card:hover { border-color: var(--link); box-shadow: 0 8px 24px color-mix(in srgb, var(--ink) 11%, transparent); transform: translateY(-2px); }
  .card-label { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; font-size: .9rem; font-weight: 700; line-height: 1.3; }
  .card-arrow { flex: none; color: var(--link); font-size: 1.1rem; }
  .card-amount { display: block; margin-top: auto; font-size: clamp(1.55rem, 2.3vw, 2.25rem); font-weight: 760; line-height: 1.15; letter-spacing: -.055em; font-variant-numeric: tabular-nums; }
  .card-caption { margin-top: .35rem; color: var(--muted); font-size: .78rem; }
  .separate-note { margin: .75rem 0 0; font-size: .78rem; line-height: 1.45; }
  .separate-note a { color: var(--link); font-weight: 650; }
  .explorer-frame { scroll-margin-top: 5.7rem; margin-top: .8rem; padding: clamp(.85rem, 2vw, 1.65rem); border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); }
  .more-links { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem 1.5rem; margin-top: 1.15rem; padding: 1rem 0; border-top: 1px solid var(--line); color: var(--muted); font-size: .84rem; }
  .more-links nav { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; }
  .more-links a { color: var(--link); font-weight: 650; white-space: nowrap; }
  @media (max-width: 780px) { .start-heading { grid-template-columns: 1fr; } .home-search { max-width: 35rem; } .budget-grid { gap: .5rem; } .budget-card { padding: .9rem; } .more-links { flex-wrap: wrap; } }
  @media (max-width: 600px) { .landing { padding-top: 1.2rem; } .budget-grid { grid-template-columns: 1fr; } .budget-card { min-height: 0; display: grid; grid-template-columns: 1fr auto; gap: .2rem .7rem; } .card-label { grid-column: 1 / -1; } .card-amount { margin-top: .2rem; font-size: 1.55rem; } .card-caption { align-self: end; margin: 0 0 .15rem; text-align: right; } .explorer-frame { padding: .7rem; scroll-margin-top: 5rem; } }
  @media (prefers-reduced-motion: reduce) { .budget-card { transition: none; } .budget-card:hover { transform: none; } }
</style>
