---
import Base from '../layouts/Base.astro';
import BudgetFlock from '../components/BudgetFlock.astro';
import SankeyExplorer from '../components/SankeyExplorer.astro';
import { roots, titles, box, children, exact } from '../lib/data';

const periods: Record<string, string> = {
  city: 'Calendar year 2026',
  cps: 'FY2026 · July 2025–June 2026',
  parks: 'Park District FY2026',
};
const descriptions: Record<string, string> = {
  city: 'The streets we travel. The services we share. The everyday work of a city.',
  cps: 'Classrooms, school buildings, and the people helping the next generation grow.',
  parks: 'Our neighborhood gathering places, lakefront escapes, and room to play.',
};
const colors = ['#2f7189', '#b14b3e', '#597961', '#886a38', '#786495', '#567b80', '#8b646d', '#506372', '#807663', '#3d6877', '#7a624c'];
const abbreviated = (cents: number) => {
  const dollars = cents / 100;
  return dollars >= 1e9 ? { amount: `$${(dollars / 1e9).toFixed(2)}`, unit: 'billion' } : { amount: `$${(dollars / 1e6).toFixed(1)}`, unit: 'million' };
};
const budgets = roots.map(root => {
  const node = box(root);
  const positive = children(root).filter(n => n.amount_cents > 0);
  const total = positive.reduce((sum, n) => sum + n.amount_cents, 0);
  return { root, title: titles[root], node, positive, total, period: periods[root] };
});
---
<Base title="A city in motion" description="A different way to see Chicago's public money. Explore real budget shares through a living, interactive visualization, then follow every line to its source.">
  <div class="motion-landing">
    <section class="motion-intro" aria-labelledby="home-title">
      <div class="intro-copy">
        <p class="edition"><span class="edition-stars" aria-hidden="true">✶ ✶ ✶ ✶</span> Chicago, Illinois <span class="edition-divider">/</span> 2026 budgets</p>
        <h1 id="home-title">A city in motion.<br/><em>A budget you can see.</em></h1>
      </div>
      <div class="intro-aside">
        <p>Streets. Schools. Neighborhood parks.<br/>Get a feel for where public money goes, then follow the details.</p>
        <a class="intro-link" href="#budget-motion">See the big picture <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="motion-section" id="budget-motion" aria-label="Budget in motion">
      <div class="section-index"><span>01 <span aria-hidden="true">/</span> The big picture</span><span>Real budgets. A different perspective.</span></div>
      <BudgetFlock />
    </section>

    <section class="budget-directory" aria-labelledby="budgets-title">
      <div class="section-index"><span>02 <span aria-hidden="true">/</span> Your way in</span><a href="/disclosures">How to read the numbers <span aria-hidden="true">↗</span></a></div>
      <div class="directory-heading">
        <h2 id="budgets-title">One city.<br/><em>Three different budgets.</em></h2>
        <p>Pick the part of Chicago you’re curious about.<br/>Every budget opens into a story of its own.</p>
      </div>
      <div class="budget-grid">
        {budgets.map(({ root, title, node, period, positive, total }, i) => (
          <article class="budget-card">
            <div class="card-top"><span class="card-number">0{i + 1}</span><span class="card-period">{period}</span></div>
            <h3><a href={`/${root}`}>{title}<span class="card-arrow" aria-hidden="true">↗</span></a></h3>
            <p class="card-description">{descriptions[root]}</p>
            {node && <p class="card-amount" aria-label={exact(node.amount_cents)}><strong>{abbreviated(node.amount_cents).amount}</strong><span>{abbreviated(node.amount_cents).unit}</span></p>}
            <div class="share-strip" aria-hidden="true">{positive.map((n, j) => <span style={`--share:${n.amount_cents / total * 100}%;--segment:${colors[j % colors.length]}`} />)}</div>
            <div class="card-bottom"><span>{positive.length} positive budget categories</span><a href={`/?box=${root}#explore`}>Follow the money <span aria-hidden="true">→</span></a></div>
          </article>
        ))}
      </div>
    </section>

    <section class="search-band" aria-labelledby="search-heading">
      <div><p class="mini-label">Find your connection</p><h2 id="search-heading">What matters <em>to you?</em></h2><p>A school. A park. A public service. Start there.</p></div>
      <form action="/find" role="search" class="home-search">
        <label for="home-search">Search the budgets</label>
        <div class="search-row"><input id="home-search" name="q" type="search" placeholder="Try “libraries” or “water”" autocomplete="off"/><button type="submit">Find it <span aria-hidden="true">↗</span></button></div>
        <div class="search-shortcuts"><span>Or explore</span><a href="/find?q=libraries">Libraries</a><a href="/find?q=parks">Parks</a><a href="/find?q=schools">Schools</a></div>
      </form>
    </section>

    <section class="explorer-section" id="explore" aria-label="Detailed budget explorer">
      <div class="section-index"><span>03 <span aria-hidden="true">/</span> Follow the money</span><a href="/sources">Backed by public sources <span aria-hidden="true">↗</span></a></div>
      <div class="explorer-frame"><SankeyExplorer /></div>
    </section>
    <aside class="closing-note"><span aria-hidden="true">✶</span><p>Less guesswork.<br/><strong>More understanding.</strong></p><a href="/about">About this project <span aria-hidden="true">↗</span></a></aside>
  </div>
</Base>
<style>
  .motion-landing { --serif: Georgia, 'Times New Roman', serif; }
  .motion-intro { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: 2rem; align-items: end; padding: clamp(2.4rem, 5vw, 5rem) 0 clamp(2.5rem, 4.5vw, 4.5rem); }
  .edition, .mini-label { display: flex; align-items: center; gap: .65rem; margin: 0 0 1.65rem; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 750; color: var(--muted); }
  .edition-stars { color: var(--accent); font-size: 1.1rem; letter-spacing: .13em; margin-right: .4rem; white-space: nowrap; }
  .edition-divider { opacity: .5; }
  h1 { max-width: none; margin: 0; font-size: clamp(2.7rem, 5.2vw, 5rem); font-weight: 660; line-height: 1.04; letter-spacing: -.065em; }
  h1 em, h2 em { font-family: var(--serif); font-weight: 400; letter-spacing: -.055em; }
  h1 em { color: #376777; }
  .intro-aside { padding-bottom: .25rem; }
  .intro-aside p { margin: 0 0 1.2rem; font-size: .94rem; line-height: 1.75; color: var(--muted); }
  .intro-link { display: inline-flex; align-items: center; gap: 2.1rem; min-height: 44px; color: var(--ink); font-size: .88rem; text-decoration: none; font-weight: 700; border-bottom: 1px solid var(--ink); }
  .intro-link span { font-size: 1.2rem; transition: transform .2s; }
  .intro-link:hover span { transform: translateY(3px); }
  .motion-section, .explorer-section { scroll-margin-top: 6rem; }
  .section-index { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .9rem 0 1.1rem; border-top: 1px solid var(--line); font-size: .68rem; letter-spacing: .075em; font-weight: 700; text-transform: uppercase; }
  .section-index > span:first-child > span { margin: 0 .8rem; color: var(--muted); }
  .section-index > span:last-child { color: var(--muted); }
  .section-index a { color: var(--muted); text-decoration: none; }
  .section-index a:hover { text-decoration: underline; }
  .budget-directory { margin-top: clamp(3rem, 7vw, 6rem); }
  .directory-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: 1.6rem 0 2rem; }
  .directory-heading h2 { margin: 0; font-size: clamp(2.1rem, 3.6vw, 3.3rem); font-weight: 620; line-height: 1.1; }
  .directory-heading p { margin: 0; color: var(--muted); font-size: .91rem; line-height: 1.7; }
  .budget-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .budget-card { padding: 1.5rem; border: 1px solid var(--line); border-radius: .4rem; background: #faf9f5; display: flex; flex-direction: column; transition: background .2s, border-color .2s; }
  .budget-card:hover { background: #fffefa; border-color: var(--line-strong); }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: .7rem; color: var(--muted); }
  .card-number { font-family: var(--serif); font-size: 1.2rem; font-style: italic; }
  .card-period { font-size: .64rem; text-align: right; }
  .budget-card h3 { margin: 1.6rem 0 .8rem; font-size: 1.25rem; font-weight: 650; letter-spacing: -.04em; }
  .budget-card h3 a { display: flex; justify-content: space-between; gap: .5rem; color: var(--ink); text-decoration: none; }
  .budget-card h3 a:hover { text-decoration: underline; }
  .card-arrow { font-size: 1.1rem; color: var(--muted); }
  .card-description { margin: 0 0 1.8rem; color: var(--muted); font-size: .85rem; line-height: 1.6; }
  .card-amount { margin: auto 0 1.4rem; display: flex; align-items: baseline; flex-wrap: wrap; gap: .5rem; line-height: 1; }
  .card-amount strong { font-size: clamp(2.2rem, 3.4vw, 3.25rem); letter-spacing: -.065em; font-weight: 610; font-variant-numeric: tabular-nums; }
  .card-amount span { color: var(--muted); font-size: .85rem; }
  .share-strip { display: flex; width: 100%; height: .5rem; overflow: hidden; border-radius: .2rem; }
  .share-strip span { width: var(--share); flex: 0 0 var(--share); height: 100%; background: var(--segment); }
  .card-bottom { display: flex; flex-direction: column; gap: 1.3rem; margin-top: .6rem; }
  .card-bottom > span { color: var(--muted); font-size: .65rem; }
  .card-bottom a { display: flex; justify-content: space-between; color: var(--ink); font-size: .8rem; font-weight: 650; text-decoration: none; min-height: 44px; align-items: center; border-top: 1px solid var(--line); }
  .card-bottom a:hover { color: var(--accent); }
  .search-band { margin: clamp(3rem, 6vw, 5rem) 0; padding: clamp(1.5rem, 4vw, 3rem); background: #e8e9df; border-radius: .4rem; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 3rem; }
  .mini-label { margin-bottom: 1rem; font-size: .65rem; }
  .search-band h2 { margin: 0; font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 620; }
  .search-band p:not(.mini-label) { margin: .8rem 0 0; color: var(--muted); font-size: .85rem; }
  .home-search label { display: block; font-size: .78rem; font-weight: 650; margin-bottom: .55rem; }
  .search-row { display: flex; min-height: 3.5rem; background: #faf9f5; border: 1px solid #bcc3b6; border-radius: .4rem; padding: .3rem; }
  .search-row:focus-within { outline: 2px solid var(--focus); outline-offset: 3px; }
  .search-row input { width: 100%; min-width: 0; padding: .55rem .65rem; border: 0; background: transparent; color: var(--ink); font-size: .88rem; outline: none; }
  .search-row input::placeholder { color: var(--muted); }
  .search-row button { flex-shrink: 0; font-size: .8rem; padding-inline: 1rem; }
  .search-shortcuts { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: .8rem; font-size: .7rem; }
  .search-shortcuts > span { color: var(--muted); }
  .explorer-frame { padding: clamp(1rem, 2.6vw, 2rem); background: var(--paper); border: 1px solid var(--line); border-radius: .4rem; }
  .explorer-frame :global(.explorer-kicker) { display: none; }
  .explorer-frame :global(.explorer-intro) { padding-top: 0; }
  .explorer-frame :global(.explorer-intro h2) { font-size: clamp(1.8rem, 3vw, 2.8rem); font-weight: 620; }
  .closing-note { display: flex; align-items: center; gap: 1.25rem; padding: 3.5rem 0 1rem; }
  .closing-note > span { color: var(--accent); font-size: 3.5rem; line-height: 1; }
  .closing-note p { margin: 0; line-height: 1.35; font-size: .95rem; color: var(--muted); }
  .closing-note strong { color: var(--ink); font-weight: 650; }
  .closing-note a { margin-left: auto; font-size: .8rem; font-weight: 600; color: var(--ink); }
  @media (max-width: 1000px) { .motion-intro { grid-template-columns: 1fr; gap: 1.5rem; } .intro-aside { display: flex; align-items: center; justify-content: space-between; gap: 2rem; } .intro-aside p { margin: 0; } h1 { font-size: clamp(2.6rem, 7.3vw, 5rem); } .card-top { align-items: start; } .budget-card { padding: 1.15rem; } .card-period { max-width: 12rem; } }
  @media (max-width: 720px) { .budget-grid { grid-template-columns: 1fr; } .budget-card { padding: 1.5rem; } .card-description { max-width: 45ch; margin-bottom: 1.3rem; } .card-amount strong { font-size: 2.8rem; } .card-bottom { gap: .9rem; } .directory-heading { flex-direction: column; align-items: start; gap: 1.2rem; } .search-band { grid-template-columns: 1fr; gap: 1.5rem; } .section-index { font-size: .6rem; letter-spacing: .04em; } .section-index > span:last-child { max-width: 14ch; text-align: right; } }
  @media (max-width: 480px) { .motion-intro { padding-top: 2rem; } .edition { gap: .35rem; font-size: .55rem; letter-spacing: .045em; margin-bottom: 1.4rem; flex-wrap: wrap; } .edition-stars { font-size: .95rem; margin-right: .25rem; } h1 { font-size: clamp(2.3rem, 8.2vw, 3.25rem); letter-spacing: -.055em; } .intro-aside { flex-direction: column; align-items: start; gap: .7rem; } .intro-aside p { font-size: .85rem; } .intro-link { font-size: .8rem; } .section-index > span:first-child > span { margin-inline: .35rem; } .section-index a { max-width: 16ch; text-align: right; } .closing-note { flex-wrap: wrap; } .closing-note a { margin-left: 0; width: 100%; } .search-band { padding: 1.1rem; } }
</style>
