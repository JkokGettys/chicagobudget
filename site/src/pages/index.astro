---
import Base from '../layouts/Base.astro';
import SankeyExplorer from '../components/SankeyExplorer.astro';
import {roots,titles,box,compact,href} from '../lib/data';
const budgets=roots.map((root)=>({root,title:titles[root],node:box(root)}));
---
<Base title="Home" description="Follow the money through Chicago's City, public schools, and parks budgets, one box at a time.">
  <div class="landing">
    <section class="intro" aria-labelledby="home-title">
      <div class="intro-copy">
        <p class="eyebrow">An open guide to Chicago's 2026 budgets</p>
        <h1 id="home-title">Big budgets.<br/><span>Clearer answers.</span></h1>
        <p class="lede">Where does public money go? Start with a big box, open it, and keep going. Every amount has a label and a source you can check.</p>
        <div class="intro-actions"><a class="action primary" href="#explore">Explore the money <span aria-hidden="true">↗</span></a><a class="action secondary" href="#choose">Choose a budget <span aria-hidden="true">↓</span></a></div>
        <p class="intro-note">Three separate budgets. No combined total.</p>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="art-label">FOLLOW THE FLOW <span>01 / 03</span></div><div class="art-track"><span></span><span></span><span></span></div><div class="art-card art-card-one">CITY <span>↗</span></div><div class="art-card art-card-two">SCHOOLS <span>↗</span></div><div class="art-card art-card-three">PARKS <span>↗</span></div><div class="art-footer">ONE BOX AT A TIME <span>● ● ●</span></div></div>
    </section>
    <section class="budget-section" id="choose" aria-labelledby="choose-title"><div class="section-heading"><div><p class="eyebrow">01 / Pick a starting point</p><h2 id="choose-title">Your city, three ways in.</h2></div><p>These are different budgets, not pieces of one total. Pick the one you want to follow.</p></div><ul class="budget-grid">{budgets.map(({root,title,node},index)=><li><a class={`budget-card budget-${root}`} href={node?href(node):`/${root}`}><span class="card-top"><span class="card-number">0{index+1} / 03</span><span class="card-arrow" aria-hidden="true">↗</span></span><span class="card-title">{title}</span><span class="card-amount">{node?compact(node.amount_cents):'Explore budget'}</span><span class="card-bottom">Open this budget <span aria-hidden="true">→</span></span></a></li>)}</ul></section>
    <section class="flow-section" id="explore" aria-labelledby="flow-title"><div class="section-heading"><div><p class="eyebrow">02 / See the bigger picture</p><h2 id="flow-title">Follow the flow.</h2></div><p>Choose a budget, then select a flow to see the boxes inside. Each number keeps its own source and label.</p></div><div class="flow-frame"><SankeyExplorer /></div></section>
    <section class="next-section" aria-labelledby="next-title"><div class="section-heading"><div><p class="eyebrow">03 / Make it yours</p><h2 id="next-title">Looking for something specific?</h2></div></div><div class="next-grid"><div class="search-panel"><h3>Find a place or service</h3><p>Look up a school, park, department, or budget box.</p><form action="/find" role="search"><label for="home-search">What are you looking for?</label><div class="search-row"><input class="search-field" id="home-search" name="q" type="search" placeholder="Try a school, park or police"/><button type="submit" aria-label="Search budgets">Search <span aria-hidden="true">↗</span></button></div></form></div><div class="guide-panel"><h3>New to budget words?</h3><p>Some amounts are printed in a budget. Others are estimates, leftovers, or money paid so far. We tell you which is which.</p><a href="/glossary">Learn the words <span aria-hidden="true">↗</span></a><a href="/about">How we built this <span aria-hidden="true">↗</span></a><a href="/gaps">What we could not find <span aria-hidden="true">↗</span></a></div></div></section>
  </div>
</Base>
<style>
.landing{--navy:#132a38;--mint:#c4f0d8;--coral:#faad89;--blue:#d7eaff}.landing section{scroll-margin-top:2rem}.intro{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,5vw,5rem);align-items:center;padding:clamp(3rem,7vw,7rem) 0 5rem}.intro h1{font-size:clamp(3.5rem,7vw,7.5rem);line-height:.98;letter-spacing:-.075em;margin:.35em 0}.intro h1 span{color:#207e76}.intro .lede{max-width:37rem;font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.5}.intro-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.action{display:inline-flex;align-items:center;justify-content:space-between;gap:2rem;min-height:3.5rem;padding:.85rem 1.2rem;border:2px solid var(--navy);border-radius:100px;font-weight:750;text-decoration:none;transition:transform .18s ease,box-shadow .18s ease}.action:hover,.budget-card:hover{transform:translateY(-4px);box-shadow:0 14px 30px #112c3020}.primary{background:var(--navy);color:white}.secondary{background:transparent;color:var(--navy)}.intro-note{color:var(--muted);font-size:.9rem;margin-top:1.2rem}.hero-art{min-height:430px;position:relative;overflow:hidden;background:var(--navy);border-radius:2rem;color:white;padding:1.6rem;box-shadow:0 30px 60px #173e4930}.art-label,.art-footer{display:flex;justify-content:space-between;font-size:.73rem;font-weight:800;letter-spacing:.17em}.art-footer{position:absolute;bottom:1.6rem;left:1.6rem;right:1.6rem}.art-track{position:absolute;inset:20% 14%;display:flex;justify-content:space-around;transform:rotate(-21deg)}.art-track span{width:2px;background:#ffffff33}.art-card{position:absolute;display:flex;align-items:center;justify-content:space-between;width:58%;padding:1.25rem 1.4rem;border-radius:1.2rem;color:var(--navy);font-size:clamp(1.25rem,2.4vw,2rem);font-weight:900;letter-spacing:-.04em;box-shadow:0 16px 24px #06192344}.art-card span{font-size:1.4rem}.art-card-one{background:var(--mint);top:24%;left:11%;transform:rotate(-8deg)}.art-card-two{background:var(--coral);top:46%;right:9%;transform:rotate(6deg)}.art-card-three{background:var(--blue);top:68%;left:16%;transform:rotate(-4deg)}.budget-section,.flow-section,.next-section{padding:2rem 0 5rem}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:2rem}.section-heading h2{font-size:clamp(2.2rem,4vw,4.2rem);letter-spacing:-.055em;margin:.2rem 0}.section-heading>p{max-width:25rem;margin:0 0 .4rem;color:var(--muted)}.budget-grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.budget-card{min-height:300px;display:flex;flex-direction:column;padding:1.5rem;border-radius:1.4rem;background:var(--mint);color:var(--navy);text-decoration:none;transition:transform .18s ease,box-shadow .18s ease}.budget-cps{background:var(--blue)}.budget-parks{background:var(--coral)}.card-top,.card-bottom{display:flex;justify-content:space-between;align-items:center}.card-number{font-size:.75rem;font-weight:850;letter-spacing:.12em}.card-arrow{display:grid;place-items:center;width:2.7rem;height:2.7rem;border:1.5px solid currentColor;border-radius:50%;font-size:1.3rem}.card-title{font-size:clamp(1.6rem,2.4vw,2.5rem);font-weight:850;line-height:1.08;letter-spacing:-.045em;margin-top:auto}.card-amount{font-size:1.3rem;font-weight:800;margin:.6rem 0 1.5rem;font-variant-numeric:tabular-nums}.card-bottom{border-top:1px solid #16354155;padding-top:1rem;font-size:.9rem;font-weight:750}.flow-frame{border:1px solid var(--line);border-radius:1.5rem;background:var(--paper);padding:clamp(.75rem,2vw,2rem);box-shadow:var(--shadow);overflow:hidden}.next-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem}.next-grid>div{border-radius:1.5rem;padding:clamp(1.5rem,3vw,2.5rem)}.next-grid h3{font-size:1.6rem;margin:0 0 .5rem}.search-panel{background:var(--navy);color:white}.search-panel p{color:#d7e8e7}.search-panel form{margin-top:2rem}.search-panel label{display:block;font-weight:700;margin-bottom:.6rem}.search-row{display:flex;gap:.5rem}.search-row input{flex:1;min-width:0;max-width:none;background:white}.search-row button{background:var(--mint);color:var(--navy);border:0;border-radius:.5rem;padding:.7rem 1rem;font-weight:800;min-height:3rem}.guide-panel{background:#e5f4ee}.guide-panel>a{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid #375a4e4a;padding:.7rem 0;color:var(--navy);font-weight:700;text-decoration:none}.guide-panel>a:hover{text-decoration:underline}@media(max-width:800px){.intro{grid-template-columns:1fr;padding-top:3rem}.hero-art{min-height:340px}.section-heading{display:block}.section-heading>p{margin-top:1rem}.budget-grid{grid-template-columns:1fr}.budget-card{min-height:220px}.next-grid{grid-template-columns:1fr}}@media(max-width:440px){.intro h1{font-size:clamp(3rem,14vw,4.5rem)}.hero-art{min-height:300px}.art-card{width:68%;padding:.9rem}.search-row{flex-direction:column}.search-row button{align-self:stretch}}@media(prefers-reduced-motion:reduce){.action,.budget-card{transition:none}.action:hover,.budget-card:hover{transform:none}}
</style>
