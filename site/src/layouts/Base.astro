---
import '../styles/global.css';
import { manifest } from '../lib/data';
const {title='Chicago budget explorer', description='Open the boxes inside Chicago public budgets.'}=Astro.props;
const current=Astro.url.pathname;
const analyticsToken=import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const nav=[['/city','City'],['/cps','Schools'],['/parks','Parks'],['/find','Find'],['/about','About']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title} | Chicago budget explorer</title>{analyticsToken&&<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:analyticsToken})}></script>}</head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><div class="wrap"><a class="brand" href="/">Chicago budget explorer</a><nav aria-label="Main navigation" class="nav">{nav.map(([url,label])=><a href={url} aria-current={current===url?'page':undefined}>{label}</a>)}</nav></div></header><main id="main" class="wrap"><slot/></main><footer class="site-footer"><div class="wrap"><p>Numbers from public budget documents. {manifest.run_at && `Data built ${manifest.run_at}.`} Every paid-so-far figure states its own period.</p><nav aria-label="Footer navigation"><a href="/sources">Sources</a><a href="/glossary">Glossary</a><a href="/gaps">What we could not find</a><a href="/contribute">Contribute</a><a href="/style-guide">Style guide</a></nav></div></footer></body></html>
